    VAR _lun = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="lun" ), [_ev] )
    VAR _mar = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="mar" ), [_ev] )

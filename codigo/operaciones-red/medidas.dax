-- Cant_Cumple_SLA  ·  tabla Medidas
Cant_Cumple_SLA =
// Tickets que cumplen SLA (afectacion_total*24 <= SLA)
// Excluye causas externas igual que Cumple_TRFn
VAR _ids_excluidos =
    CALCULATETABLE(
        VALUES( rms_disruptions[id] ),
        TREATAS( VALUES( excluded[Causa] ), rms_disruptions[causa] )
    )
VAR _ids_cumple =
    CALCULATETABLE(
        VALUES( rms_disruptions[id] ),
        rms_disruptions[Cumple_SLA_col] = "Cumple"
    )
RETURN
    COUNTROWS( EXCEPT( _ids_cumple, _ids_excluidos ) )

-- Cant_NoCumple_SLA  ·  tabla Medidas
Cant_NoCumple_SLA =

COUNTROWS(
    FILTER(
        rms_disruptions,
        rms_disruptions[afectacion_total] * 24 > RELATED(SLA[SLA])
    )
)

-- Pct_Cumplimiento_SLA  ·  tabla Medidas
Pct_Cumplimiento_SLA =

DIVIDE(
    [Cant_Cumple_SLA],
    [Cant_Cumple_SLA] + [Cant_NoCumple_SLA],
    0
)

-- Serv_Afectados_Internet  ·  tabla Medidas
Serv_Afectados_Internet =

CALCULATE(
    SUM(rms_disruptions[cantidad]),
    rms_disruptions[servicio] = "Internet"
)

-- Serv_Afectados_Telefonia  ·  tabla Medidas
Serv_Afectados_Telefonia =

CALCULATE(
    SUM(rms_disruptions[cantidad]),
    rms_disruptions[servicio] = "Telefonía"
)

-- Serv_Afectados_Television  ·  tabla Medidas
Serv_Afectados_Television =

CALCULATE(
    SUM(rms_disruptions[cantidad]),
    rms_disruptions[servicio] = "Televisión"
)

-- Total_Eventos  ·  tabla Medidas
Total_Eventos =
VAR _ids_excluidos =
    CALCULATETABLE(
        VALUES( rms_disruptions[id] ),
        TREATAS( VALUES( excluded[Causa] ), rms_disruptions[causa] )
    )
VAR _todos_ids = VALUES( rms_disruptions[id] )
VAR _ids_validos = EXCEPT( _todos_ids, _ids_excluidos )
RETURN
    COUNTROWS( _ids_validos )

-- Cumple_TRFn  ·  tabla Medidas
Cumple_TRFn =
VAR _ids_excluidos =
    CALCULATETABLE(
        VALUES( rms_disruptions[id] ),
        TREATAS( VALUES( excluded[Causa] ), rms_disruptions[causa] )
    )
VAR _ids_cumple =
    CALCULATETABLE(
        VALUES( rms_disruptions[id] ),
        rms_disruptions[Cumple_SLA_col] = "Cumple"
    )
RETURN
    COUNTROWS( EXCEPT( _ids_cumple, _ids_excluidos ) )

-- NoCumple_TRFn  ·  tabla Medidas
NoCumple_TRFn =
VAR _ids_excluidos =
    CALCULATETABLE(
        VALUES( rms_disruptions[id] ),
        TREATAS( VALUES( excluded[Causa] ), rms_disruptions[causa] )
    )
VAR _ids_nocumple =
    CALCULATETABLE(
        VALUES( rms_disruptions[id] ),
        rms_disruptions[Cumple_SLA_col] = "No cumple"
    )
RETURN
    COUNTROWS( EXCEPT( _ids_nocumple, _ids_excluidos ) )

-- Pct_TRFn  ·  tabla Medidas
Pct_TRFn =
DIVIDE( [Cumple_TRFn], [Total_Eventos], BLANK() )

-- Pct_Serv_Internet  ·  tabla Medidas
Pct_Serv_Internet =
VAR _internet = CALCULATE( SUM( rms_disruptions[cantidad] ), rms_disruptions[servicio] = "Internet" )
VAR _total    = SUM( rms_disruptions[cantidad] )
RETURN
    IF(
        _total = 0 || ISBLANK( _total ),
        "",
        FORMAT( DIVIDE( _internet, _total, 0 ), "0.00%" )
    )

-- Pct_Serv_Telefonia  ·  tabla Medidas
Pct_Serv_Telefonia =
VAR _tel   = CALCULATE( SUM( rms_disruptions[cantidad] ), rms_disruptions[servicio] = "Telefonía" )
VAR _total = SUM( rms_disruptions[cantidad] )
RETURN
    IF(
        _total = 0 || ISBLANK( _total ),
        "",
        FORMAT( DIVIDE( _tel, _total, 0 ), "0.00%" )
    )

-- Pct_Serv_Television  ·  tabla Medidas
Pct_Serv_Television =
VAR _tv    = CALCULATE( SUM( rms_disruptions[cantidad] ), rms_disruptions[servicio] = "Televisión" )
VAR _total = SUM( rms_disruptions[cantidad] )
RETURN
    IF(
        _total = 0 || ISBLANK( _total ),
        "",
        FORMAT( DIVIDE( _tv, _total, 0 ), "0.00%" )
    )

-- Afectacion_Ponderada  ·  tabla Medidas
Afectacion_Ponderada =
SUMX(
    rms_disruptions,
    rms_disruptions[afectacion] * ( rms_disruptions[porcentaje] / 100 )
)

-- Cant_Eventos_Afectacion  ·  tabla Medidas
Cant_Eventos_Afectacion =
// Cantidad de eventos con afectacion > 0, solo Internet
// Excluye causas externas (tabla excluded) para coherencia con Total_Eventos
VAR _ids_excluidos =
    CALCULATETABLE(
        VALUES( rms_disruptions[id] ),
        TREATAS( VALUES( excluded[Causa] ), rms_disruptions[causa] )
    )
VAR _ids_afectacion =
    CALCULATETABLE(
        VALUES( rms_disruptions[id] ),
        rms_disruptions[servicio] = "Internet",
        rms_disruptions[afectacion] > 0
    )
RETURN
    COUNTROWS( EXCEPT( _ids_afectacion, _ids_excluidos ) )

-- MTBF  ·  tabla Medidas
MTBF =
VAR _eventos = [Cant_Eventos_Afectacion]
RETURN
    IF(
        _eventos = 0 || ISBLANK( _eventos ),
        BLANK(),
        DIVIDE( 28, _eventos )
    )

-- Tiempo_Disponible_28d  ·  tabla Medidas
Tiempo_Disponible_28d =
28 * 24

-- Afectacion_Ponderada_Horas  ·  tabla Medidas
Afectacion_Ponderada_Horas =
// Afectacion ponderada en HORAS para la red en contexto
// Formula: SUM(afectacion_dias * porcentaje/100) * 24
// Usa columna 'afectacion' (no afectacion_total) segun requerimiento de Victor
// Solo servicio Internet segun requerimiento MTBF/Uptime
CALCULATE(
    SUMX(
        rms_disruptions,
        rms_disruptions[afectacion] * ( rms_disruptions[porcentaje] / 100 )
    ) * 24,
    rms_disruptions[servicio] = "Internet"
)

-- Uptime  ·  tabla Medidas
Uptime =
// Uptime = (672h - Afectacion_Ponderada_Horas) / 672h
// 672h = 28 dias * 24 horas = tiempo total disponible por nodo
// Se evalua en el contexto de red/nodo que provea el visual
// Resultado entre 0 y 1 (formato 0.00%)
VAR _total_h = 28 * 24  -- 672 horas
VAR _afect_h = [Afectacion_Ponderada_Horas]
VAR _uptime_raw = DIVIDE( _total_h - _afect_h, _total_h, BLANK() )
RETURN
    IF(
        ISBLANK( _afect_h ),
        BLANK(),
        // Clamp entre 0 y 1 para evitar negativos por datos anomalos
        MAX( 0, MIN( 1, _uptime_raw ) )
    )

-- Flag_Incumple_MTBF  ·  tabla Medidas
Flag_Incumple_MTBF =
VAR _mtbf = [MTBF]
RETURN
    IF(
        ISBLANK( _mtbf ),
        BLANK(),
        IF( _mtbf < 7, 1, 0 )
    )

-- Flag_Incumple_Uptime  ·  tabla Medidas
Flag_Incumple_Uptime =
VAR _uptime = [Uptime]
VAR _tec = SELECTEDVALUE( rms_disruptions[tec], "" )
VAR _umbral =
    SWITCH(
        _tec,
        "HFC",  0.995,
        "GPON", 0.998,
        0.995  -- default conservador
    )
RETURN
    IF(
        ISBLANK( _uptime ),
        BLANK(),
        IF( _uptime < _umbral, 1, 0 )
    )

-- Flag_Nodo_Critico  ·  tabla Medidas
Flag_Nodo_Critico =
VAR _mtbf_flag   = [Flag_Incumple_MTBF]
VAR _uptime_flag = [Flag_Incumple_Uptime]
RETURN
    IF(
        ISBLANK( _mtbf_flag ) || ISBLANK( _uptime_flag ),
        BLANK(),
        IF( _mtbf_flag = 1 && _uptime_flag = 1, 1, 0 )
    )

-- Nodos_Incumplen  ·  tabla Medidas
Nodos_Incumplen =
// Nodos_Incumplen: redes que incumplen MTBF<7 AND Uptime<umbral
// en el corte mas reciente disponible en el modelo
// Nota: los datos tienen cortes mensuales. Para logica de 3 cortes
// consecutivos se requiere una tabla de historial de flags por red.

VAR _fecha_max = MAXX( CALCULATETABLE( VALUES(rms_disruptions[date]), ALL(rms_disruptions) ), rms_disruptions[date] )

RETURN
    COUNTROWS(
        FILTER(
            CALCULATETABLE( VALUES( rms_disruptions[red] ), ALL(Calendar) ),
            VAR _r      = rms_disruptions[red]
            VAR _tec    = CALCULATE(
                FIRSTNONBLANK( rms_disruptions[tec], 1 ),
                rms_disruptions[date] = _fecha_max,
                ALL(Calendar)
            )
            VAR _umbral = IF( _tec = "GPON", 0.998, 0.995 )
            VAR _ah     = CALCULATE(
                SUMX( rms_disruptions, rms_disruptions[afectacion] * rms_disruptions[porcentaje] / 100 ) * 24,
                rms_disruptions[servicio] = "Internet",
                rms_disruptions[date] = _fecha_max,
                ALL(Calendar)
            )
            VAR _nev    = CALCULATE(
                COUNTROWS( FILTER( rms_disruptions,
                    rms_disruptions[servicio] = "Internet"
                    && rms_disruptions[afectacion] > 0 ) ),
                rms_disruptions[date] = _fecha_max,
                ALL(Calendar)
            )
            VAR _mtbf   = IF( _nev > 0, DIVIDE( 28, _nev ), BLANK() )
            VAR _upt    = IF( NOT ISBLANK(_ah), MAX(0, (672 - _ah)/672), BLANK() )
            RETURN
                NOT ISBLANK(_mtbf)
                && NOT ISBLANK(_upt)
                && _mtbf < 7
                && _upt  < _umbral
        )
    )

-- Titulo_Pagina_TRFn  ·  tabla Medidas
Titulo_Pagina_TRFn =
VAR _tec  = SELECTEDVALUE( rms_disruptions[tec],  "TODAS LAS TECNOLOGÍAS" )
VAR _tipo = SELECTEDVALUE( rms_disruptions[tipo], "TODOS LOS TIPOS" )
RETURN
    _tipo & " | " & _tec & " — Cumplimiento TRFn"

-- HTML_KPI_TotalEventos  ·  tabla Medidas
HTML_KPI_TotalEventos =
VAR _val     = [Total_Eventos_inc]
VAR _cumple  = [Cumple_TRFn_inc]
VAR _pct_val = DIVIDE( _cumple, _val, 0 )
VAR _pct_txt = IF( ISBLANK(_val), "-", FORMAT( _pct_val, "0.0%" ) )
VAR _bar_w   = FORMAT( ROUND( _pct_val * 100, 0 ), "0" )
VAR _c_acc   = "#6B1F7C"
VAR _c_bg    = "#E8D5F0"
VAR _c_txt   = "#3A0A4A"
VAR _punto   = UNICHAR(183)
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border:1px solid #C9A8D8;border-top:5px solid " & _c_acc & ";border-radius:4px;padding:16px 18px;'>"
& "<div style='font-size:12px;font-weight:600;color:#5A1A6E;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;'>Total Eventos</div>"
& "<div style='font-size:32px;font-weight:800;color:" & _c_acc & ";line-height:1;margin-bottom:8px;'>" & IF(ISBLANK(_val), "-", FORMAT(_val, "#,0")) & "</div>"
& "<div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;'>"
  & "<span style='font-size:12px;font-weight:500;color:#3D3D3D;'>Cumplimiento TRF</span>"
  & "<span style='font-size:13px;font-weight:700;color:" & _c_txt & ";'>" & _pct_txt & "</span>"
& "</div>"
& "<div style='height:5px;background:#D8B8E8;border-radius:3px;overflow:hidden;margin-bottom:8px;'>"
  & "<div style='height:100%;width:" & _bar_w & "%;background:" & _c_acc & ";border-radius:3px;'></div>"
& "</div>"
& "<div style='background:" & _c_bg & ";border-radius:4px;padding:5px 10px;display:inline-block;'>"
  & "<span style='font-size:11px;font-weight:700;color:" & _c_txt & ";'>" & FORMAT(COALESCE(_cumple,0),"#,0") & " cumple " & _punto & " " & FORMAT(COALESCE([NoCumple_TRFn_inc],0),"#,0") & " no cumple</span>"
& "</div>"
& "</div>"

-- HTML_KPI_CumpleTRFn  ·  tabla Medidas
HTML_KPI_CumpleTRFn =
VAR _val     = [Cumple_TRFn_inc]
VAR _total   = [Total_Eventos_inc]
VAR _pct_val = DIVIDE( _val, _total, 0 )
VAR _pct_txt = IF( ISBLANK(_val), "-", FORMAT( _pct_val, "0.0%" ) )
VAR _es_crit = NOT ISBLANK(_pct_val) && _pct_val < 0.75
VAR _es_ale  = NOT ISBLANK(_pct_val) && _pct_val >= 0.75 && _pct_val < 0.78
VAR _c_acc   = IF(_es_crit, "#B71C1C", IF(_es_ale, "#BF360C", "#1B5E20"))
VAR _c_txt   = IF(_es_crit, "#7F0000", IF(_es_ale, "#7F3000", "#0A3D0A"))
VAR _bar_w   = FORMAT( ROUND( _pct_val * 100, 0 ), "0" )
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border:1px solid #C9A8D8;border-top:5px solid " & _c_acc & ";border-radius:4px;padding:16px 18px;'>"
& "<div style='font-size:12px;font-weight:600;color:#5A1A6E;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;'>Cumple TRF</div>"
& "<div style='font-size:32px;font-weight:800;color:" & _c_acc & ";line-height:1;margin-bottom:8px;'>" & IF(ISBLANK(_val), "-", FORMAT(_val, "#,0")) & "</div>"
& "<div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;'>"
  & "<span style='font-size:12px;font-weight:500;color:#3D3D3D;'>% TRF</span>"
  & "<span style='font-size:13px;font-weight:700;color:" & _c_txt & ";'>" & _pct_txt & "</span>"
& "</div>"
& "<div style='height:5px;background:#D8B8E8;border-radius:3px;overflow:hidden;'>"
  & "<div style='height:100%;width:" & _bar_w & "%;background:" & _c_acc & ";border-radius:3px;'></div>"
& "</div>"
& "</div>"

-- HTML_KPI_NoCumpleTRFn  ·  tabla Medidas
HTML_KPI_NoCumpleTRFn =
VAR _val     = [NoCumple_TRFn_inc]
VAR _total   = [Total_Eventos_inc]
VAR _pct_val = DIVIDE( _val, _total, 0 )
VAR _pct_txt = IF( ISBLANK(_val), "-", FORMAT( _pct_val, "0.0%" ) )
VAR _es_alto = NOT ISBLANK(_pct_val) && _pct_val > 0.25
VAR _es_med  = NOT ISBLANK(_pct_val) && _pct_val > 0.22 && _pct_val <= 0.25
VAR _c_acc   = IF(_es_alto, "#B71C1C", IF(_es_med, "#BF360C", "#33691E"))
VAR _c_txt   = IF(_es_alto, "#7F0000", IF(_es_med, "#7F3000", "#1B3A09"))
VAR _bar_w   = FORMAT( ROUND( _pct_val * 100, 0 ), "0" )
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border:1px solid #C9A8D8;border-top:5px solid " & _c_acc & ";border-radius:4px;padding:16px 18px;'>"
& "<div style='font-size:12px;font-weight:600;color:#5A1A6E;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;'>No Cumple TRF</div>"
& "<div style='font-size:32px;font-weight:800;color:" & _c_acc & ";line-height:1;margin-bottom:8px;'>" & IF(ISBLANK(_val), "-", FORMAT(_val, "#,0")) & "</div>"
& "<div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;'>"
  & "<span style='font-size:12px;font-weight:500;color:#3D3D3D;'>% sobre total</span>"
  & "<span style='font-size:13px;font-weight:700;color:" & _c_txt & ";'>" & _pct_txt & "</span>"
& "</div>"
& "<div style='height:5px;background:#D8B8E8;border-radius:3px;overflow:hidden;'>"
  & "<div style='height:100%;width:" & _bar_w & "%;background:" & _c_acc & ";border-radius:3px;'></div>"
& "</div>"
& "</div>"

-- HTML_Tendencia_TRFn  ·  tabla Medidas
HTML_Tendencia_TRFn =
VAR _base =
    CALCULATETABLE(
        SUMMARIZE( vw_rms_incidents, vw_rms_incidents[Year_inc], vw_rms_incidents[MonthNo_inc], vw_rms_incidents[Month_inc] ),
        ALL( vw_rms_incidents[Year_inc] ),
        ALL( vw_rms_incidents[MonthNo_inc] ),
        ALL( vw_rms_incidents[Month_inc] )
    )
VAR _data =
    FILTER(
        ADDCOLUMNS(
            _base,
            "_key",  vw_rms_incidents[Year_inc] * 100 + vw_rms_incidents[MonthNo_inc],
            "_fort",
                VAR _y = vw_rms_incidents[Year_inc]
                VAR _m = vw_rms_incidents[MonthNo_inc]
                RETURN CALCULATE( [Pct_TRFn_Fortuito_inc], vw_rms_incidents[Year_inc]=_y, vw_rms_incidents[MonthNo_inc]=_m, ALL(vw_rms_incidents[Month_inc]) ),
            "_prog",
                VAR _y = vw_rms_incidents[Year_inc]
                VAR _m = vw_rms_incidents[MonthNo_inc]
                RETURN CALCULATE( [Pct_TRFn_Programado_inc], vw_rms_incidents[Year_inc]=_y, vw_rms_incidents[MonthNo_inc]=_m, ALL(vw_rms_incidents[Month_inc]) ),
            "_tot",
                VAR _y = vw_rms_incidents[Year_inc]
                VAR _m = vw_rms_incidents[MonthNo_inc]
                RETURN CALCULATE( [Total_Eventos_inc], vw_rms_incidents[Year_inc]=_y, vw_rms_incidents[MonthNo_inc]=_m, ALL(vw_rms_incidents[Month_inc]) )
        ),
        [_tot] > 0
    )
VAR _n    = COUNTROWS(_data)
VAR _kmin = MINX(_data,[_key])
VAR _kmin_year = INT(_kmin/100)
VAR _w=560 VAR _h=155 VAR _pl=34 VAR _pr=16 VAR _pt=10 VAR _pb=26
VAR _cw=_w-_pl-_pr VAR _ch=_h-_pt-_pb
VAR _ymin=0.55 VAR _ymax=1.00 VAR _yr=_ymax-_ymin
VAR _step=IF(_n<=1,_cw,INT(_cw/(_n-1)))
VAR _grid=
    "<line x1='" &_pl& "' y1='" &INT(_pt+_ch*0.00)& "' x2='" &(_w-_pr)& "' y2='" &INT(_pt+_ch*0.00)& "' stroke='#EDE0F5' stroke-width='1'/>"
    & "<line x1='" &_pl& "' y1='" &INT(_pt+_ch*0.25)& "' x2='" &(_w-_pr)& "' y2='" &INT(_pt+_ch*0.25)& "' stroke='#EDE0F5' stroke-width='1'/>"
    & "<line x1='" &_pl& "' y1='" &INT(_pt+_ch*0.50)& "' x2='" &(_w-_pr)& "' y2='" &INT(_pt+_ch*0.50)& "' stroke='#EDE0F5' stroke-width='1'/>"
    & "<line x1='" &_pl& "' y1='" &INT(_pt+_ch*0.75)& "' x2='" &(_w-_pr)& "' y2='" &INT(_pt+_ch*0.75)& "' stroke='#EDE0F5' stroke-width='1'/>"
    & "<text x='" &(_pl-3)& "' y='" &INT(_pt+_ch*0.00+4)& "' text-anchor='end' font-size='9' fill='#C4A8D8'>100%</text>"
    & "<text x='" &(_pl-3)& "' y='" &INT(_pt+_ch*0.25+4)& "' text-anchor='end' font-size='9' fill='#C4A8D8'>89%</text>"
    & "<text x='" &(_pl-3)& "' y='" &INT(_pt+_ch*0.50+4)& "' text-anchor='end' font-size='9' fill='#C4A8D8'>78%</text>"
    & "<text x='" &(_pl-3)& "' y='" &INT(_pt+_ch*0.75+4)& "' text-anchor='end' font-size='9' fill='#C4A8D8'>67%</text>"
VAR _pf=CONCATENATEX(_data,IF(NOT ISBLANK([_fort]),VAR _i=RANKX(_data,[_key],,ASC,Dense)-1 VAR _x=_pl+_i*_step VAR _y=INT(_pt+_ch*(1-([_fort]-_ymin)/_yr)) RETURN _x&","&_y)," ",[_key],ASC)
VAR _pp=CONCATENATEX(_data,IF(NOT ISBLANK([_prog]),VAR _i=RANKX(_data,[_key],,ASC,Dense)-1 VAR _x=_pl+_i*_step VAR _y=INT(_pt+_ch*(1-([_prog]-_ymin)/_yr)) RETURN _x&","&_y)," ",[_key],ASC)
VAR _df=CONCATENATEX(_data,IF(NOT ISBLANK([_fort]),VAR _i=RANKX(_data,[_key],,ASC,Dense)-1 VAR _x=_pl+_i*_step VAR _y=INT(_pt+_ch*(1-([_fort]-_ymin)/_yr)) RETURN "<circle cx='"&_x&"' cy='"&_y&"' r='3' fill='#9B3DB8' stroke='white' stroke-width='1.5'/>"),"",[_key],ASC)
VAR _dp=CONCATENATEX(_data,IF(NOT ISBLANK([_prog]),VAR _i=RANKX(_data,[_key],,ASC,Dense)-1 VAR _x=_pl+_i*_step VAR _y=INT(_pt+_ch*(1-([_prog]-_ymin)/_yr)) RETURN "<circle cx='"&_x&"' cy='"&_y&"' r='3' fill='#6B1F7C' stroke='white' stroke-width='1.5'/>"),"",[_key],ASC)
VAR _lb=CONCATENATEX(_data,VAR _i=RANKX(_data,[_key],,ASC,Dense)-1 VAR _x=_pl+_i*_step VAR _ya=INT([_key]/100) VAR _lbl=IF(vw_rms_incidents[Month_inc]="Ene"&&_ya<>_kmin_year,"Ene '"&RIGHT(FORMAT(_ya,"0"),2),vw_rms_incidents[Month_inc]) RETURN "<text x='"&_x&"' y='"&(_h-4)&"' text-anchor='middle' font-size='9' fill='#C4A8D8'>"&_lbl&"</text>","",[_key],ASC)
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border:1px solid #DDD0E8;border-radius:6px;padding:14px 16px;'>"
&"<div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;'>"
&"<span style='font-size:11px;font-weight:600;color:#6B1F7C;text-transform:uppercase;letter-spacing:0.5px;'>Tendencia Mensual % TRFn</span>"
&"<div style='display:flex;gap:14px;'>"
&"<span style='font-size:10px;color:#757575;display:flex;align-items:center;gap:5px;'><svg width='16' height='6'><line x1='0' y1='3' x2='16' y2='3' stroke='#9B3DB8' stroke-width='2'/></svg>Fortuito</span>"
&"<span style='font-size:10px;color:#757575;display:flex;align-items:center;gap:5px;'><svg width='16' height='6'><line x1='0' y1='3' x2='16' y2='3' stroke='#6B1F7C' stroke-width='2' stroke-dasharray='5,2'/></svg>Programado</span>"
&"</div></div>"
&"<svg width='100%' viewBox='0 0 "&_w&" "&_h&"' xmlns='http://www.w3.org/2000/svg'>"
&_grid
&"<polyline points='"&_pf&"' fill='none' stroke='#9B3DB8' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>"
&"<polyline points='"&_pp&"' fill='none' stroke='#6B1F7C' stroke-width='2' stroke-dasharray='6,3' stroke-linejoin='round' stroke-linecap='round'/>"
&_df&_dp&_lb
&"</svg></div>"

-- HTML_Semaforo_TRFn  ·  tabla Medidas
HTML_Semaforo_TRFn =
VAR _umbral = 0.85
VAR _filas =
    FILTER(
        ADDCOLUMNS(
            SUMMARIZE(
                rms_disruptions,
                rms_disruptions[servicio],
                rms_disruptions[tec]
            ),
            "_tot",  CALCULATE( [Total_Eventos] ),
            "_pct",  CALCULATE( DIVIDE( [Cumple_TRFn], [Total_Eventos], BLANK() ) ),
            "_sla",  CALCULATE( MAX( SLA[SLA] ) )
        ),
        [_tot] > 0
            && ( rms_disruptions[servicio] = "Internet" || rms_disruptions[servicio] = "Telefonía" || rms_disruptions[servicio] = "Televisión" )
            && ( rms_disruptions[tec] = "GPON" || rms_disruptions[tec] = "HFC" )
    )
VAR _rows =
    CONCATENATEX(
        _filas,
        VAR _p   = [_pct]
        VAR _ok  = NOT ISBLANK(_p) && _p >= _umbral
        VAR _al  = NOT ISBLANK(_p) && _p >= 0.80 && _p < _umbral
        VAR _ca  = IF( _ok, "#1E8C45", IF( _al, "#E65100", "#C62828" ) )
        VAR _cb  = IF( _ok, "#E8F5E9", IF( _al, "#FFF3E0", "#FFEBEE" ) )
        VAR _ct  = IF( _ok, "#145C2E", IF( _al, "#BF360C", "#B71C1C" ) )
        VAR _est = IF( _ok, "OK",      IF( _al, "ALERTA",  "CRÍTICO" ) )
        VAR _dr  = IF( NOT _ok && NOT _al, "<div style='width:8px;height:8px;border-radius:50%;background:#C62828;'></div>", "<div style='width:8px;height:8px;border-radius:50%;background:#E8E0EF;'></div>" )
        VAR _dy  = IF( _al, "<div style='width:8px;height:8px;border-radius:50%;background:#E65100;'></div>", "<div style='width:8px;height:8px;border-radius:50%;background:#E8E0EF;'></div>" )
        VAR _dg  = IF( _ok, "<div style='width:8px;height:8px;border-radius:50%;background:#1E8C45;'></div>", "<div style='width:8px;height:8px;border-radius:50%;background:#E8E0EF;'></div>" )
        VAR _pt  = IF( ISBLANK(_p), "—", FORMAT( _p, "0.0%" ) )
        VAR _sl  = IF( ISBLANK([_sla]), "—", FORMAT([_sla],"0") & " h" )
        RETURN
        "<div style='display:flex;align-items:center;justify-content:space-between;padding:8px 10px;background:#FAFAFA;border:1px solid #EDE0F5;border-left:3px solid " &_ca& ";border-radius:4px;margin-bottom:5px;'>"
        & "<div style='display:flex;align-items:center;gap:7px;'>"
          & "<div style='display:flex;flex-direction:column;gap:3px;'>" &_dr& _dy& _dg& "</div>"
          & "<div><div style='font-size:11px;font-weight:600;color:#212121;'>" &rms_disruptions[servicio]& " · " &rms_disruptions[tec]& "</div>"
          & "<div style='font-size:9px;color:#9B3DB8;margin-top:1px;'>" &FORMAT([_tot],"#,0")& " eventos · SLA " &_sl& "</div></div>"
        & "</div>"
        & "<div style='text-align:right;'><div style='font-size:17px;font-weight:700;color:" &_ca& ";line-height:1;'>" &_pt& "</div>"
        & "<div style='margin-top:3px;background:" &_cb& ";border-radius:3px;padding:2px 6px;display:inline-block;'><span style='font-size:9px;font-weight:700;color:" &_ct& ";'>" &_est& "</span></div></div>"
        & "</div>",
        "", rms_disruptions[servicio], ASC
    )
RETURN
"<div style='font-family:Segoe UI,sans-serif;padding:14px 16px;background:#fff;border:1px solid #DDD0E8;border-radius:6px;'>"
& "<div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;'>"
& "<span style='font-size:11px;font-weight:600;color:#6B1F7C;text-transform:uppercase;letter-spacing:0.5px;'>Semáforo SLA por Servicio</span>"
& "<span style='font-size:9px;color:#9B3DB8;background:#F0EBF5;border:1px solid #DDD0E8;border-radius:3px;padding:2px 7px;'>Meta ≥ 85%</span>"
& "</div>" & _rows & "</div>"

-- HTML_Titulo_TRFn  ·  tabla Medidas
HTML_Titulo_TRFn =
VAR _tec  = SELECTEDVALUE( vw_rms_incidents[tec],  "TODAS" )
VAR _tipo = SELECTEDVALUE( vw_rms_incidents[TIPO], "TODOS" )
VAR _year = SELECTEDVALUE( Calendar[Year],          "" )
VAR _mes  = SELECTEDVALUE( Calendar[Month short],   "" )
VAR _dia  = SELECTEDVALUE( Calendar[DayNro],        0 )
VAR _periodo =
    IF( _dia > 0,
        _mes & " " & FORMAT(_dia,"0") & ", " & _year,
        IF( _mes <> "", _mes & " " & _year, _year )
    )
VAR _tot     = [Total_Eventos_inc]
VAR _pct_val = [Pct_TRFn_inc]
VAR _pct_txt = IF( ISBLANK(_pct_val), "-", FORMAT( _pct_val, "0.0%" ) )
VAR _es_ok   = NOT ISBLANK(_pct_val) && _pct_val >= 0.78
VAR _es_al   = NOT ISBLANK(_pct_val) && _pct_val >= 0.75 && _pct_val < 0.78
VAR _c_pct   = IF( _es_ok, "#1B5E20", IF( _es_al, "#BF360C", "#B71C1C" ) )
VAR _c_dot   = IF( _es_ok, "#1B5E20", IF( _es_al, "#BF360C", "#B71C1C" ) )
VAR _fort_txt = FORMAT( COALESCE([Pct_TRFn_Fortuito_inc],  0), "0.0%" )
VAR _prog_txt = FORMAT( COALESCE([Pct_TRFn_Programado_inc],0), "0.0%" )
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border:1px solid #C9A8D8;border-top:5px solid #6B1F7C;border-radius:4px;padding:16px 18px;height:100%;display:flex;flex-direction:column;justify-content:space-between;'>"
& "<div>"
  & "<div style='font-size:11px;font-weight:700;color:#5A1A6E;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:6px;'>Cumplimiento TRF</div>"
  & "<div style='font-size:17px;font-weight:800;color:#3A0A4A;line-height:1.3;'>" & _tipo & " &#183; " & _tec & "</div>"
  & "<div style='font-size:13px;font-weight:600;color:#4A1557;margin-top:3px;'>" & _periodo & "</div>"
& "</div>"
& "<div style='margin-top:10px;padding-top:10px;border-top:2px solid #D8B8E8;'>"
  & "<div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;'>"
    & "<div style='display:flex;align-items:center;gap:7px;'>"
      & "<div style='width:10px;height:10px;border-radius:50%;background:" & _c_dot & ";'></div>"
      & "<span style='font-size:12px;font-weight:600;color:#2D2D2D;'>" & FORMAT(COALESCE(_tot,0),"#,0") & " eventos</span>"
    & "</div>"
    & "<span style='font-size:20px;font-weight:800;color:" & _c_pct & ";'>" & _pct_txt & "</span>"
  & "</div>"
  & "<div style='display:flex;gap:8px;'>"
    & "<div style='flex:1;background:#E8D5F0;border-radius:4px;padding:5px 8px;text-align:center;'>"
      & "<div style='font-size:10px;font-weight:700;color:#4A1557;'>Fortuito</div>"
      & "<div style='font-size:14px;font-weight:800;color:#3A0A4A;'>" & _fort_txt & "</div>"
    & "</div>"
    & "<div style='flex:1;background:#E8D5F0;border-radius:4px;padding:5px 8px;text-align:center;'>"
      & "<div style='font-size:10px;font-weight:700;color:#4A1557;'>Programado</div>"
      & "<div style='font-size:14px;font-weight:800;color:#3A0A4A;'>" & _prog_txt & "</div>"
    & "</div>"
  & "</div>"
& "</div>"
& "</div>"

-- total_registros  ·  tabla Medidas
total_registros =
COUNTROWS(rms_disruptions)

-- Total_Eventos_inc  ·  tabla Medidas
Total_Eventos_inc =
DISTINCTCOUNT( vw_rms_incidents[ID] )

-- Cumple_TRFn_inc  ·  tabla Medidas
Cumple_TRFn_inc =
COUNTROWS(
    FILTER(
        vw_rms_incidents,
        vw_rms_incidents[Cumple_SLA_inc] = "Cumple"
    )
)

-- NoCumple_TRFn_inc  ·  tabla Medidas
NoCumple_TRFn_inc =
COUNTROWS(
    FILTER(
        vw_rms_incidents,
        vw_rms_incidents[Cumple_SLA_inc] = "No Cumple"
    )
)

-- Pct_TRFn_inc  ·  tabla Medidas
Pct_TRFn_inc =
DIVIDE( [Cumple_TRFn_inc], [Total_Eventos_inc], BLANK() )

-- Pct_TRFn_Fortuito_inc  ·  tabla Medidas
Pct_TRFn_Fortuito_inc =
VAR _TipoSeleccionado = SELECTEDVALUE(vw_rms_incidents[TIPO])
RETURN
IF(
    _TipoSeleccionado IN { "Programado", "Emergente" },
    BLANK(),
    DIVIDE(
        CALCULATE( DISTINCTCOUNT(vw_rms_incidents[ID]), vw_rms_incidents[TIPO] = "Fortuito" ),
        CALCULATE( [Total_Eventos_inc], ALL(vw_rms_incidents[TIPO]) )
    )
)

-- Pct_TRFn_Programado_inc  ·  tabla Medidas
Pct_TRFn_Programado_inc =
VAR _TipoSeleccionado = SELECTEDVALUE(vw_rms_incidents[TIPO])
RETURN
IF(
    _TipoSeleccionado = "Fortuito",
    BLANK(),
    DIVIDE(
        CALCULATE( DISTINCTCOUNT(vw_rms_incidents[ID]), vw_rms_incidents[TIPO] IN { "Programado", "Emergente" } ),
        CALCULATE( [Total_Eventos_inc], ALL(vw_rms_incidents[TIPO]) )
    )
)

-- TRF_Promedio_inc  ·  tabla Medidas
TRF_Promedio_inc =
AVERAGEX( vw_rms_incidents, vw_rms_incidents[trf_neto_horas] )

-- TRF_Max_inc  ·  tabla Medidas
TRF_Max_inc =
MAXX( vw_rms_incidents, vw_rms_incidents[trf_neto_horas] )

-- HTML_Tabla_TRFn_inc  ·  tabla Medidas
HTML_Tabla_TRFn_inc =
VAR _tipo   = SELECTEDVALUE( vw_rms_incidents[TIPO], "TODOS" )
VAR _titulo = UPPER( _tipo & " " & UNICHAR(8212) & " CUMPLIMIENTO TRFn" )
VAR _header  = "#6B1F7C"
VAR _header2 = "#9B3DB8"
VAR _borde   = "#DDD0E8"
VAR _rojo    = "#C62828"
VAR _negro   = "#212121"
VAR _umbral  = 0.80

VAR _filas =
    CONCATENATEX(
        FILTER(
            ADDCOLUMNS(
                ALLSELECTED( vw_rms_incidents[ciudad] ),
                "_tot",  CALCULATE( [Total_Eventos_inc] ),
                "_cum",  CALCULATE( [Cumple_TRFn_inc] ),
                "_noc",  CALCULATE( [NoCumple_TRFn_inc] ),
                "_pct",  CALCULATE( DIVIDE( [Cumple_TRFn_inc], [Total_Eventos_inc], BLANK() ) ),
                "_fort", CALCULATE( [Pct_TRFn_Fortuito_inc] ),
                "_prog", CALCULATE( [Pct_TRFn_Programado_inc] )
            ),
            NOT ISBLANK( [_tot] ) && [_tot] > 0
        ),
        VAR _p   = [_pct]
        VAR _pt  = IF( ISBLANK(_p), "", FORMAT(_p, "0.00%") )
        VAR _ft  = IF( ISBLANK([_fort]), "", FORMAT([_fort], "0.00%") )
        VAR _pr  = IF( ISBLANK([_prog]), "", FORMAT([_prog], "0.00%") )
        VAR _cp  = IF( NOT ISBLANK(_p) && _p < _umbral, _rojo, _negro )
        VAR _fw  = IF( NOT ISBLANK(_p) && _p < _umbral, "bold", "normal" )
        VAR _s0  = "padding:5px 8px;border:1px solid " & _borde & ";"
        VAR _td  = "style='" & _s0 & "'"
        VAR _tdr = "style='" & _s0 & "text-align:right;'"
        VAR _tdp = "style='" & _s0 & "text-align:right;color:" & _cp & ";font-weight:" & _fw & ";'"
        RETURN
        "<tr>"
        & "<td " & _td  & ">" & [ciudad] & "</td>"
        & "<td " & _tdr & ">" & FORMAT( COALESCE([_tot],0), "0" ) & "</td>"
        & "<td " & _tdr & ">" & FORMAT( COALESCE([_cum],0), "0" ) & "</td>"
        & "<td " & _tdr & ">" & FORMAT( COALESCE([_noc],0), "0" ) & "</td>"
        & "<td " & _tdp & ">" & _pt & "</td>"
        & "<td " & _tdr & ">" & _ft & "</td>"
        & "<td " & _tdr & ">" & _pr & "</td>"
        & "</tr>",
        "", [_pct], DESC
    )

VAR _tot_g = [Total_Eventos_inc]
VAR _cum_g = [Cumple_TRFn_inc]
VAR _noc_g = [NoCumple_TRFn_inc]
VAR _pct_g = DIVIDE( _cum_g, _tot_g, BLANK() )
VAR _pt_g  = IF( ISBLANK(_pct_g), "", FORMAT(_pct_g, "0.00%") )
VAR _cp_g  = IF( NOT ISBLANK(_pct_g) && _pct_g < _umbral, _rojo, _negro )
VAR _ft_g  = IF( ISBLANK([Pct_TRFn_Fortuito_inc]),  "", FORMAT([Pct_TRFn_Fortuito_inc],  "0.00%") )
VAR _pr_g  = IF( ISBLANK([Pct_TRFn_Programado_inc]), "", FORMAT([Pct_TRFn_Programado_inc], "0.00%") )

VAR _th  = "style='padding:6px 8px;border:1px solid " & _borde & ";color:white;text-align:center;font-size:12px;background:" & _header  & ";'"
VAR _th2 = "style='padding:6px 8px;border:1px solid " & _borde & ";color:white;text-align:center;font-size:12px;background:" & _header2 & ";'"
VAR _tdf = "padding:6px 8px;border:1px solid " & _borde & ";font-weight:bold;"

RETURN
"<div style='font-family:Segoe UI,sans-serif;font-size:12px;'>"
& "<div style='background:" & _header & ";color:white;padding:8px 10px;font-weight:bold;font-size:13px;text-align:center;margin-bottom:4px;letter-spacing:0.5px;'>" & _titulo & "</div>"
& "<table style='border-collapse:collapse;width:100%;'>"
& "<thead><tr>"
& "<th " & _th  & ">Ciudad</th>"
& "<th " & _th  & ">Total</th>"
& "<th " & _th  & ">Cumple TRFn</th>"
& "<th " & _th  & ">No Cumple TRFn</th>"
& "<th " & _th  & ">% TRFn</th>"
& "<th " & _th2 & ">% Fortuito</th>"
& "<th " & _th2 & ">% Programado</th>"
& "</tr></thead>"
& "<tbody>" & _filas & "</tbody>"
& "<tfoot><tr style='background:#F0EBF5;'>"
& "<td style='" & _tdf & "color:#6B1F7C;'>TOTAL</td>"
& "<td style='" & _tdf & "text-align:right;'>" & IF(ISBLANK(_tot_g),"0",FORMAT(_tot_g,"0")) & "</td>"
& "<td style='" & _tdf & "text-align:right;'>" & IF(ISBLANK(_cum_g),"0",FORMAT(_cum_g,"0")) & "</td>"
& "<td style='" & _tdf & "text-align:right;'>" & IF(ISBLANK(_noc_g),"0",FORMAT(_noc_g,"0")) & "</td>"
& "<td style='" & _tdf & "text-align:right;color:" & _cp_g & ";font-weight:bold;'>" & _pt_g & "</td>"
& "<td style='" & _tdf & "text-align:right;'>" & _ft_g & "</td>"
& "<td style='" & _tdf & "text-align:right;'>" & _pr_g & "</td>"
& "</tr></tfoot>"
& "</table></div>"

-- Pct_Serv_Internet_inc  ·  tabla Medidas
Pct_Serv_Internet_inc =
VAR _tec = SELECTEDVALUE( rms_disruptions[tec], "TODOS" )
VAR _ciudades = VALUES( rms_disruptions[ciudad] )

VAR _afect_gpon =
    IF( _tec = "HFC", 0,
        CALCULATE(
            SUM( rms_disruptions[SRVAfecXTiempoAfectado] ),
            rms_disruptions[servicio] = "Internet",
            rms_disruptions[tec] = "GPON"
        )
    )
VAR _afect_hfc =
    IF( _tec = "GPON", 0,
        CALCULATE(
            SUM( rms_disruptions[SRVAfecXTiempoAfectado] ),
            rms_disruptions[servicio] = "Internet",
            rms_disruptions[tec] = "HFC"
        )
    )
VAR _numerador = _afect_gpon + _afect_hfc

VAR _base_gpon =
    IF( _tec = "HFC", 0,
        CALCULATE(
            SUM( Servicios_gpon[Internet] ),
            TREATAS( _ciudades, Servicios_gpon[Ciudad] )
        )
    )
VAR _base_hfc =
    IF( _tec = "GPON", 0,
        CALCULATE(
            SUM( Servicios_hfc[Internet] ),
            TREATAS( _ciudades, Servicios_hfc[Ciudad] )
        )
    )
VAR _denominador = COALESCE( _base_gpon, 0 ) + COALESCE( _base_hfc, 0 )

RETURN DIVIDE( _numerador, _denominador, BLANK() )

-- Pct_Serv_Telefonia_inc  ·  tabla Medidas
Pct_Serv_Telefonia_inc =
VAR _tec = SELECTEDVALUE( rms_disruptions[tec], "TODOS" )
VAR _ciudades = VALUES( rms_disruptions[ciudad] )

VAR _afect_gpon =

& "<table style='border-collapse:collapse;width:100%;'><thead>"&_header&"</thead>"
& "<tbody>"&_fila_h1&_fila_h2&_fila_h3&_fila_h4&_fila_h5&_fila_h6&"</tbody></table>"
& "<div style='margin-top:6px;display:flex;align-items:center;gap:8px;font-size:9px;color:#9B3DB8;'><span>Menos</span>"
  & "<div style='display:flex;gap:2px;'>"
    & "<div style='width:16px;height:10px;background:#F3EAF7;border:0.5px solid #C9A8D8;'></div>"
    & "<div style='width:16px;height:10px;background:#DEB8E6;'></div>"
    & "<div style='width:16px;height:10px;background:#C585D0;'></div>"
    & "<div style='width:16px;height:10px;background:#AC52BB;'></div>"
    & "<div style='width:16px;height:10px;background:#893395;'></div>"
  & "</div><span>Mas</span></div></div>"

-- Afectacion_Real_Horas  ·  tabla Medidas
Afectacion_Real_Horas =
SUMX(
    SUMMARIZE(
        CALCULATETABLE( rms_disruptions, rms_disruptions[servicio] = "Internet" ),
        rms_disruptions[id],
        "_afec",
        CALCULATE(
            SUMX( rms_disruptions, rms_disruptions[afectacion_real] * rms_disruptions[porcentaje] / 100 ),
            rms_disruptions[servicio] = "Internet"
        )
    ),
    [_afec]
) * 24

-- Pct_TRFn_Por_Tipo_inc  ·  tabla Medidas
Pct_TRFn_Por_Tipo_inc =
VAR _tipo  = SELECTEDVALUE( vw_rms_incidents[TIPO] )
VAR _total = CALCULATE( [Total_Eventos_inc], ALL( vw_rms_incidents[TIPO] ) )
RETURN DIVIDE( CALCULATE( [Total_Eventos_inc] ), _total, BLANK() )

-- Tasa_NoCumple_TRFn_inc  ·  tabla Medidas
Tasa_NoCumple_TRFn_inc =
DIVIDE( [NoCumple_TRFn_inc], [Total_Eventos_inc], BLANK() )

-- Umbral_Uptime_inc  ·  tabla Medidas
Umbral_Uptime_inc =
VAR _tec = SELECTEDVALUE( rms_disruptions[tec], "TODOS" )
RETURN
    IF( _tec = "GPON", 0.998, 0.995 )

-- Afectacion_Promedio_Horas  ·  tabla Medidas
Afectacion_Promedio_Horas =
VAR _base =
    FILTER(
        CALCULATETABLE(
            SUMMARIZE( rms_disruptions, rms_disruptions[red], rms_disruptions[ciudad],
                "_ev",   CALCULATE( DISTINCTCOUNT( rms_disruptions[id] ), rms_disruptions[servicio] = "Internet" ),
                "_afec", CALCULATE( SUMX( rms_disruptions, rms_disruptions[afectacion_real] * rms_disruptions[porcentaje] / 100 ), rms_disruptions[servicio] = "Internet" ) * 24
            ),
            rms_disruptions[servicio] = "Internet"
        ),
        NOT ISBLANK( [_ev] ) && [_ev] > 0
    )
RETURN
    AVERAGEX( _base, [_afec] )

-- Cant_Nodos_con_Eventos  ·  tabla Medidas
Cant_Nodos_con_Eventos =
COUNTROWS(
    FILTER(
        CALCULATETABLE(
            SUMMARIZE( rms_disruptions, rms_disruptions[red], rms_disruptions[ciudad],
                "_ev", CALCULATE( DISTINCTCOUNT( rms_disruptions[id] ), rms_disruptions[servicio] = "Internet" )
            ),
            rms_disruptions[servicio] = "Internet"
        ),
        NOT ISBLANK( [_ev] ) && [_ev] > 0
    )
)

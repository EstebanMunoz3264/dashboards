    VAR _il=DIVIDE(COALESCE(_lun,0)-_min,_max-_min,0) VAR _im=DIVIDE(COALESCE(_mar,0)-_min,_max-_min,0) VAR _ii=DIVIDE(COALESCE(_mie,0)-_min,_max-_min,0) VAR _ij=DIVIDE(COALESCE(_jue,0)-_min,_max-_min,0) VAR _iv=DIVIDE(COALESCE(_vie,0)-_min,_max-_min,0) VAR _is=DIVIDE(COALESCE(_sab,0)-_min,_max-_min,0) VAR _id=DIVIDE(COALESCE(_dom,0)-_min,_max-_min,0)
    VAR _cl="rgb("&FORMAT(INT(243-(243-137)*_il),"0")&","&FORMAT(INT(234-(234-51)*_il),"0")&","&FORMAT(INT(247-(247-149)*_il),"0")&")" VAR _cm="rgb("&FORMAT(INT(243-(243-137)*_im),"0")&","&FORMAT(INT(234-(234-51)*_im),"0")&","&FORMAT(INT(247-(247-149)*_im),"0")&")" VAR _ci="rgb("&FORMAT(INT(243-(243-137)*_ii),"0")&","&FORMAT(INT(234-(234-51)*_ii),"0")&","&FORMAT(INT(247-(247-149)*_ii),"0")&")" VAR _cj="rgb("&FORMAT(INT(243-(243-137)*_ij),"0")&","&FORMAT(INT(234-(234-51)*_ij),"0")&","&FORMAT(INT(247-(247-149)*_ij),"0")&")" VAR _cv="rgb("&FORMAT(INT(243-(243-137)*_iv),"0")&","&FORMAT(INT(234-(234-51)*_iv),"0")&","&FORMAT(INT(247-(247-149)*_iv),"0")&")" VAR _cs="rgb("&FORMAT(INT(243-(243-137)*_is),"0")&","&FORMAT(INT(234-(234-51)*_is),"0")&","&FORMAT(INT(247-(247-149)*_is),"0")&")" VAR _cd="rgb("&FORMAT(INT(243-(243-137)*_id),"0")&","&FORMAT(INT(234-(234-51)*_id),"0")&","&FORMAT(INT(247-(247-149)*_id),"0")&")"
    VAR _tl=IF(_il>0.5,"#fff","#3C1048") VAR _tm=IF(_im>0.5,"#fff","#3C1048") VAR _ti=IF(_ii>0.5,"#fff","#3C1048") VAR _tj=IF(_ij>0.5,"#fff","#3C1048") VAR _tv=IF(_iv>0.5,"#fff","#3C1048") VAR _ts=IF(_is>0.5,"#fff","#3C1048") VAR _td2=IF(_id>0.5,"#fff","#3C1048")

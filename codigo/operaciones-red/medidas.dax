    VAR _tl=IF(_il>0.5,"#fff","#3C1048") VAR _tm=IF(_im>0.5,"#fff","#3C1048") VAR _ti=IF(_ii>0.5,"#fff","#3C1048") VAR _tj=IF(_ij>0.5,"#fff","#3C1048") VAR _tv=IF(_iv>0.5,"#fff","#3C1048") VAR _ts=IF(_is>0.5,"#fff","#3C1048") VAR _td2=IF(_id>0.5,"#fff","#3C1048")

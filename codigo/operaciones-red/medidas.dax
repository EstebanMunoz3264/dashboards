        CALCULATE(
            SUM( rms_disruptions[SRVAfecXTiempoAfectado] ),
            rms_disruptions[servicio] = "Telefonía",
            rms_disruptions[tec] = "GPON"
        )
    )
VAR _afect_hfc =
    IF( _tec = "GPON", 0,
        CALCULATE(
            SUM( rms_disruptions[SRVAfecXTiempoAfectado] ),
            rms_disruptions[servicio] = "Telefonía",
            rms_disruptions[tec] = "HFC"
        )
    )
VAR _numerador = _afect_gpon + _afect_hfc

VAR _base_gpon =
    IF( _tec = "HFC", 0,
        CALCULATE(
            SUM( Servicios_gpon[Telefonía] ),
            TREATAS( _ciudades, Servicios_gpon[Ciudad] )
        )
    )
VAR _base_hfc =
    IF( _tec = "GPON", 0,
        CALCULATE(
            SUM( Servicios_hfc[Telefonía] ),
            TREATAS( _ciudades, Servicios_hfc[Ciudad] )
        )
    )
VAR _denominador = COALESCE( _base_gpon, 0 ) + COALESCE( _base_hfc, 0 )

RETURN DIVIDE( _numerador, _denominador, BLANK() )

-- Pct_Serv_Television_inc  ·  tabla Medidas
Pct_Serv_Television_inc =
VAR _tec = SELECTEDVALUE( rms_disruptions[tec], "TODOS" )
VAR _ciudades = VALUES( rms_disruptions[ciudad] )

VAR _afect_gpon =
    IF( _tec = "HFC", 0,
        CALCULATE(
            SUM( rms_disruptions[SRVAfecXTiempoAfectado] ),
            rms_disruptions[servicio] = "Televisión",
            rms_disruptions[tec] = "GPON"
        )
    )
VAR _afect_hfc =
    IF( _tec = "GPON", 0,
        CALCULATE(
            SUM( rms_disruptions[SRVAfecXTiempoAfectado] ),
            rms_disruptions[servicio] = "Televisión",
            rms_disruptions[tec] = "HFC"
        )
    )
VAR _numerador = _afect_gpon + _afect_hfc

VAR _base_gpon =
    IF( _tec = "HFC", 0,
        CALCULATE(
            SUM( Servicios_gpon[Televisión] ),
            TREATAS( _ciudades, Servicios_gpon[Ciudad] )
        )
    )
VAR _base_hfc =
    IF( _tec = "GPON", 0,
        CALCULATE(
            SUM( Servicios_hfc[Televisión] ),
            TREATAS( _ciudades, Servicios_hfc[Ciudad] )
        )
    )
VAR _denominador = COALESCE( _base_gpon, 0 ) + COALESCE( _base_hfc, 0 )

RETURN DIVIDE( _numerador, _denominador, BLANK() )

-- Cant_Eventos_inc  ·  tabla Medidas
Cant_Eventos_inc =
CALCULATE(
    DISTINCTCOUNT( rms_disruptions[id] ),
    rms_disruptions[servicio] = "Internet",
    rms_disruptions[afectacion] > 0
)

-- MTBF_inc  ·  tabla Medidas
MTBF_inc =
VAR _dias_periodo = 28
VAR _data =
    CALCULATETABLE(
        rms_disruptions,
        rms_disruptions[servicio] = "Internet"
    )
VAR _mtbf_por_nodo =
    SUMMARIZE(
        _data,
        rms_disruptions[red],
        rms_disruptions[ciudad],
        "_eventos", DISTINCTCOUNT( rms_disruptions[id] )
    )
RETURN
    AVERAGEX(
        FILTER( _mtbf_por_nodo, [_eventos] > 0 ),
        DIVIDE( _dias_periodo, [_eventos] )
    )

-- Flag_Incumple_MTBF_inc  ·  tabla Medidas
Flag_Incumple_MTBF_inc =
VAR _m = [MTBF_inc]
RETURN IF( NOT ISBLANK(_m) && _m < 7, 1, 0 )

-- Afectacion_Ponderada_inc  ·  tabla Medidas
Afectacion_Ponderada_inc =
BLANK()

-- Uptime_inc  ·  tabla Medidas
Uptime_inc =
VAR _hp = 28 * 24
VAR _base =
    SUMMARIZE(
        CALCULATETABLE( rms_disruptions, rms_disruptions[servicio] = "Internet" ),
        rms_disruptions[red],
        rms_disruptions[ciudad],
        "_afec",
        CALCULATE(
            SUMX( rms_disruptions, rms_disruptions[afectacion_real] * rms_disruptions[porcentaje] / 100 ),
            rms_disruptions[servicio] = "Internet"
        ) * 24
    )
RETURN
    AVERAGEX( _base, DIVIDE( _hp - [_afec], _hp ) )

-- Flag_Incumple_Uptime_inc  ·  tabla Medidas
Flag_Incumple_Uptime_inc =
VAR _u   = [Uptime_inc]
VAR _tec = SELECTEDVALUE( rms_disruptions[tec], "HFC" )
VAR _umb = IF( _tec = "GPON", 0.998, 0.995 )
RETURN IF( NOT ISBLANK(_u) && _u < _umb, 1, 0 )

-- Nodos_Incumplen_inc  ·  tabla Medidas
Nodos_Incumplen_inc =
COUNTROWS(
    FILTER(
        CALCULATETABLE( VALUES(vw_rms_incidents[red]), ALL(Calendar) ),
        VAR _r      = vw_rms_incidents[red]
        VAR _tec    = CALCULATE( FIRSTNONBLANK(vw_rms_incidents[tec],1), ALL(Calendar) )
        VAR _umbral = IF( _tec = "GPON", 0.998, 0.995 )
        VAR _ev     = CALCULATE( DISTINCTCOUNT(vw_rms_incidents[ID]), vw_rms_incidents[red]=_r, rms_disruptions[servicio]="Internet", ALL(Calendar) )
        VAR _af     = CALCULATE( SUMX(rms_disruptions, rms_disruptions[afectacion_real]*rms_disruptions[porcentaje]/100)*24, vw_rms_incidents[red]=_r, rms_disruptions[servicio]="Internet", ALL(Calendar) )
        VAR _mtbf   = DIVIDE(28, _ev)
        VAR _upt    = DIVIDE(28*24 - _af, 28*24)
        RETURN NOT ISBLANK(_mtbf) && NOT ISBLANK(_upt) && _mtbf < 7 && _upt < _umbral
    )
)

-- HTML_Tabla_MTBF  ·  tabla Medidas
HTML_Tabla_MTBF =
VAR _tec_sel = SELECTEDVALUE( vw_rms_incidents[tec], "TODAS" )
VAR _titulo  = UPPER( "MTBF " & UNICHAR(183) & " UPTIME POR RED " & UNICHAR(8212) & " " & _tec_sel )
VAR _header  = "#6B1F7C"
VAR _header2 = "#9B3DB8"
VAR _borde   = "#DDD0E8"
VAR _rojo    = "#C62828"
VAR _ambar   = "#E65100"
VAR _verde   = "#1E8C45"
VAR _negro   = "#212121"

VAR _all_d = CALCULATETABLE( VALUES(rms_disruptions[date]), ALL(rms_disruptions) )
VAR _d1 = MAXX(_all_d, rms_disruptions[date])
VAR _d2 = MAXX(FILTER(_all_d,rms_disruptions[date]<_d1),rms_disruptions[date])
VAR _d3 = MAXX(FILTER(_all_d,rms_disruptions[date]<_d2),rms_disruptions[date])
VAR _d4 = MAXX(FILTER(_all_d,rms_disruptions[date]<_d3),rms_disruptions[date])
VAR _d5 = MAXX(FILTER(_all_d,rms_disruptions[date]<_d4),rms_disruptions[date])
VAR _d6 = MAXX(FILTER(_all_d,rms_disruptions[date]<_d5),rms_disruptions[date])

VAR _base =
    FILTER(
        ADDCOLUMNS(
            ALLSELECTED( vw_rms_incidents[red] ),
            "_tec",   CALCULATE(FIRSTNONBLANK(vw_rms_incidents[tec],1)),
            "_ciu",   CALCULATE(FIRSTNONBLANK(vw_rms_incidents[ciudad],1)),
            "_tot",   CALCULATE([Total_Eventos_inc]),
            "_fort",  CALCULATE([Cant_Fortuitos_inc]),
            "_prog",  CALCULATE([Cant_Programados_inc]),
            "_afect", CALCULATE([Afectacion_Real_Horas]),
            "_mtbf",  CALCULATE([MTBF_inc]),
            "_upt",   CALCULATE([Uptime_inc]),
            "_gp",    CALCULATE([GP_inc])
        ),
        NOT ISBLANK([_tot]) && [_tot] > 0 && NOT ISBLANK([_tec])
    )

VAR _data =
    ADDCOLUMNS(
        _base,
        "_umb", IF([_tec]="GPON",0.998,0.995),
        "_sem",
            VAR _r   = [red]
            VAR _umb = IF([_tec]="GPON",0.998,0.995)
            RETURN CALCULATE( MAX( Nodos_SemConsecutivas[SemConsecutivas] ), Nodos_SemConsecutivas[red]=_r )
    )

VAR _filas =
    CONCATENATEX(
        _data,
        VAR _ah   = COALESCE([_afect],0)
        VAR _hh   = INT(_ah)
        VAR _mm   = INT((_ah-_hh)*60)
        VAR _ss   = INT(((_ah-_hh)*60-_mm)*60)
        VAR _afmt = FORMAT(_hh,"0")&":"&FORMAT(_mm,"00")&":"&FORMAT(_ss,"00")
        VAR _c_mtbf = IF(ISBLANK([_mtbf]),_negro,IF([_mtbf]<7,_rojo,_verde))
        VAR _c_upt  = IF(ISBLANK([_upt]),_negro,IF([_upt]<[_umb],IF([_upt]<([_umb]-0.01),_rojo,_ambar),_verde))
        VAR _c_sem  = IF([_sem]>=3,_rojo,IF([_sem]>=1,_ambar,_negro))
        VAR _bg_row = IF([_gp]=1&&[_sem]>=3,"#FFF5F5","#FAFAFA")
        VAR _bl_row = IF([_gp]=1&&[_sem]>=3,"3px solid "&_rojo,"1px solid "&_borde)
        VAR _icon   = IF([_gp]=1&&[_sem]>=3,UNICHAR(9888)&" ","")
        VAR _s0="padding:5px 8px;border:1px solid "&_borde&";"
        VAR _td="style='"&_s0&"'"
        VAR _tdr="style='"&_s0&"text-align:right;'"
        VAR _tdc="style='"&_s0&"text-align:center;'"
        VAR _tdm="style='"&_s0&"text-align:right;font-weight:600;color:"&_c_mtbf&";'"
        VAR _tdu="style='"&_s0&"text-align:right;font-weight:600;color:"&_c_upt&";'"
        VAR _tds="style='"&_s0&"text-align:center;font-weight:700;color:"&_c_sem&";'"
        RETURN
        "<tr style='background:"&_bg_row&";border-left:"&_bl_row&";'>"
        &"<td "&_td &">"&COALESCE([_ciu],"")&"</td>"
        &"<td "&_td &">"&_icon&[red]&"</td>"
        &"<td "&_tdr&">"&FORMAT(COALESCE([_tot],0),"0")&"</td>"
        &"<td "&_tdr&">"&IF(ISBLANK([_fort]),"0",FORMAT([_fort],"0"))&"</td>"
        &"<td "&_tdr&">"&IF(ISBLANK([_prog]),"0",FORMAT([_prog],"0"))&"</td>"
        &"<td "&_tdr&">"&_afmt&"</td>"
        &"<td "&_tdm&">"&IF(ISBLANK([_mtbf]),"-",FORMAT([_mtbf],"0.0"))&"</td>"
        &"<td "&_tdu&">"&IF(ISBLANK([_upt]),"-",FORMAT([_upt],"0.00%"))&"</td>"
        &"<td "&_tdc&">"&IF([_gp]=1,"1","0")&"</td>"
        &"<td "&_tds&">"&IF([_sem]=0,"",FORMAT([_sem],"0"))&"</td>"
        &"</tr>",
        "", [_sem], DESC
    )

VAR _th ="style='padding:6px 8px;border:1px solid #DDD0E8;color:white;text-align:center;font-size:11px;background:"&_header&";'"
VAR _th2="style='padding:6px 8px;border:1px solid #DDD0E8;color:white;text-align:center;font-size:11px;background:"&_header2&";'"
RETURN
"<div style='font-family:Segoe UI,sans-serif;font-size:12px;'>"
&"<div style='background:"&_header&";color:white;padding:8px 10px;font-weight:bold;font-size:13px;text-align:center;margin-bottom:4px;letter-spacing:0.5px;'>"&_titulo&"</div>"
&"<table style='border-collapse:collapse;width:100%;'>"
&"<thead><tr>"
  &"<th "&_th &" rowspan='2'>Ciudad</th>"
  &"<th "&_th &" rowspan='2'>Nodo</th>"
  &"<th "&_th2&" colspan='3'>N Eventos</th>"
  &"<th "&_th2&" rowspan='2'>Afectacion</th>"
  &"<th "&_th2&" rowspan='2'>MTBF</th>"
  &"<th "&_th2&" rowspan='2'>Uptime</th>"
  &"<th "&_th2&" rowspan='2'>GP</th>"
  &"<th "&_th2&" rowspan='2'>Sem.Consec.</th>"
&"</tr><tr>"
  &"<th "&_th2&">Total</th>"
  &"<th "&_th2&">Fortuito</th>"
  &"<th "&_th2&">Programado</th>"
&"</tr></thead>"
&"<tbody>"&_filas&"</tbody>"
&"</table>"
&"<div style='margin-top:6px;display:flex;gap:14px;font-size:10px;color:#757575;'>"
  &"<span><span style='color:"&_rojo&";font-weight:700;'>&#x25A0;</span> GP=1 y >=3 sem.</span>"
  &"<span><span style='color:"&_ambar&";font-weight:700;'>&#x25A0;</span> GP=1 <3 sem.</span>"
  &"<span><span style='color:"&_verde&";font-weight:700;'>&#x25A0;</span> Cumple</span>"
  &"<span style='margin-left:auto;'>MTBF <7d " & UNICHAR(183) & " HFC>=99.5% " & UNICHAR(183) & " GPON>=99.8%</span>"
&"</div></div>"

-- SemConsecutivas_inc  ·  tabla Medidas
SemConsecutivas_inc =
VAR _ciudad = SELECTEDVALUE( rms_disruptions[ciudad] )
VAR _red    = SELECTEDVALUE( rms_disruptions[red] )
VAR _tec    = SELECTEDVALUE( rms_disruptions[tec] )
RETURN
    CALCULATE(
        MAX( Nodos_SemConsecutivas[SemConsecutivas] ),
        Nodos_SemConsecutivas[ciudad] = _ciudad,
        Nodos_SemConsecutivas[red]    = _red,
        Nodos_SemConsecutivas[tec]    = _tec
    )

-- Cant_Fortuitos_inc  ·  tabla Medidas
Cant_Fortuitos_inc =
CALCULATE(
    DISTINCTCOUNT( rms_disruptions[id] ),
    rms_disruptions[servicio] = "Internet",
    rms_disruptions[afectacion] > 0,
    rms_disruptions[tipo_agrupado] = "Fortuito"
)

-- Cant_Programados_inc  ·  tabla Medidas
Cant_Programados_inc =
CALCULATE(
    DISTINCTCOUNT( rms_disruptions[id] ),
    rms_disruptions[servicio] = "Internet",
    rms_disruptions[afectacion] > 0,
    rms_disruptions[tipo_agrupado] = "Programado"
)

-- Afectacion_fmt  ·  tabla Medidas
Afectacion_fmt =
VAR _afec_horas =
    SUMX(
        SUMMARIZE(
            CALCULATETABLE( rms_disruptions, rms_disruptions[servicio] = "Internet" ),
            rms_disruptions[id],
            "_afec",
            CALCULATE(
                SUMX( rms_disruptions, rms_disruptions[afectacion_real] * rms_disruptions[porcentaje] / 100 ),
                rms_disruptions[servicio] = "Internet"
            )
        ),
        [_afec]
    ) * 24
VAR _horas    = INT( _afec_horas )
VAR _minutos  = INT( ( _afec_horas - _horas ) * 60 )
VAR _segundos = INT( ( ( _afec_horas - _horas ) * 60 - _minutos ) * 60 )
RETURN
    IF(
        ISBLANK( _afec_horas ), BLANK(),
        FORMAT( _horas, "0" ) & ":" &
        FORMAT( _minutos, "00" ) & ":" &
        FORMAT( _segundos, "00" )
    )

-- GP_inc  ·  tabla Medidas
GP_inc =
VAR _horas_periodo = 28 * 24
VAR _tec = SELECTEDVALUE( rms_disruptions[tec], "TODOS" )
VAR _umbral_uptime = IF( _tec = "GPON", 0.998, 0.995 )
VAR _ev = CALCULATE( DISTINCTCOUNT( rms_disruptions[id] ), rms_disruptions[servicio] = "Internet" )
VAR _afec_horas =
    SUMX(
        SUMMARIZE(
            CALCULATETABLE( rms_disruptions, rms_disruptions[servicio] = "Internet" ),
            rms_disruptions[id],
            "_afec",
            CALCULATE(
                SUMX( rms_disruptions, rms_disruptions[afectacion_real] * rms_disruptions[porcentaje] / 100 ),
                rms_disruptions[servicio] = "Internet"
            )
        ),
        [_afec]
    ) * 24
VAR _mtbf   = DIVIDE( 28, _ev )
VAR _uptime = DIVIDE( _horas_periodo - _afec_horas, _horas_periodo )
RETURN IF( _mtbf < 7 && _uptime < _umbral_uptime, 1, BLANK() )

-- Nodos_Criticos_3sem  ·  tabla Medidas
Nodos_Criticos_3sem =
BLANK()

-- HTML_Nodos_Criticos  ·  tabla Medidas
HTML_Nodos_Criticos =
BLANK()

-- Nodos_Incumplen_MTBF_inc  ·  tabla Medidas
Nodos_Incumplen_MTBF_inc =
VAR _base =
    FILTER(
        CALCULATETABLE(
            SUMMARIZE( rms_disruptions, rms_disruptions[red], rms_disruptions[ciudad],
                "_ev", CALCULATE( DISTINCTCOUNT( rms_disruptions[id] ), rms_disruptions[servicio] = "Internet" )
            ),
            rms_disruptions[servicio] = "Internet"
        ),
        NOT ISBLANK( [_ev] ) && [_ev] > 0
    )
RETURN COUNTROWS( FILTER( _base, DIVIDE( 28, [_ev] ) < 7 ) )

-- Pct_Cumple_MTBF_inc  ·  tabla Medidas
Pct_Cumple_MTBF_inc =
VAR _base =
    FILTER(
        CALCULATETABLE(
            SUMMARIZE( rms_disruptions, rms_disruptions[red], rms_disruptions[ciudad],
                "_ev", CALCULATE( DISTINCTCOUNT( rms_disruptions[id] ), rms_disruptions[servicio] = "Internet" )
            ),
            rms_disruptions[servicio] = "Internet"
        ),
        NOT ISBLANK( [_ev] ) && [_ev] > 0
    )
VAR _total   = COUNTROWS( _base )
VAR _cumplen = COUNTROWS( FILTER( _base, DIVIDE( 28, [_ev] ) >= 7 ) )
RETURN DIVIDE( _cumplen, _total, BLANK() )

-- Nodos_Incumplen_Uptime_inc  ·  tabla Medidas
Nodos_Incumplen_Uptime_inc =
VAR _hp = 28 * 24
VAR _tec    = SELECTEDVALUE( rms_disruptions[tec], "TODOS" )
VAR _umbral = IF( _tec = "GPON", 0.998, 0.995 )
VAR _base =
    FILTER(
        CALCULATETABLE(
            SUMMARIZE( rms_disruptions, rms_disruptions[red], rms_disruptions[ciudad],
                "_ev",   CALCULATE( DISTINCTCOUNT( rms_disruptions[id] ), rms_disruptions[servicio] = "Internet" ),
                "_afec", CALCULATE( SUMX( rms_disruptions, rms_disruptions[afectacion_real] * rms_disruptions[porcentaje] / 100 ), rms_disruptions[servicio] = "Internet" ) * 24
            ),
            rms_disruptions[servicio] = "Internet"
        ),
        NOT ISBLANK( [_ev] ) && [_ev] > 0
    )
RETURN COUNTROWS( FILTER( _base, DIVIDE( _hp - [_afec], _hp ) < _umbral ) )

-- Nodos_Criticos_inc  ·  tabla Medidas
Nodos_Criticos_inc =
VAR _horas_periodo = 28 * 24
VAR _tec = SELECTEDVALUE( rms_disruptions[tec], "TODOS" )
VAR _umbral_uptime = IF( _tec = "GPON", 0.998, 0.995 )
VAR _mtbf_por_nodo =
    SUMMARIZE(
        CALCULATETABLE( rms_disruptions, rms_disruptions[servicio] = "Internet" ),
        rms_disruptions[red], rms_disruptions[ciudad],
        "_ev", DISTINCTCOUNT( rms_disruptions[id] )
    )
VAR _uptime_por_nodo =
    ADDCOLUMNS(
        SUMMARIZE(
            CALCULATETABLE( rms_disruptions, rms_disruptions[servicio] = "Internet" ),
            rms_disruptions[red], rms_disruptions[ciudad]
        ),
        "_uptime",
        CALCULATE(
            DIVIDE(
                _horas_periodo -
                SUMX(
                    SUMMARIZE(
                        FILTER( rms_disruptions, rms_disruptions[servicio] = "Internet" ),
                        rms_disruptions[id],
                        "_afec", SUMX( FILTER( rms_disruptions, rms_disruptions[servicio] = "Internet" ), rms_disruptions[afectacion_real] * rms_disruptions[porcentaje] / 100 )
                    ),
                    [_afec]
                ) * 24,
                _horas_periodo
            )
        )
    )
VAR _incumple_mtbf   = SELECTCOLUMNS( FILTER( _mtbf_por_nodo, DIVIDE(28,[_ev]) < 7 ), "r",[red],"c",[ciudad] )
VAR _incumple_uptime = SELECTCOLUMNS( FILTER( _uptime_por_nodo, [_uptime] < _umbral_uptime ), "r",[red],"c",[ciudad] )
RETURN COUNTROWS( INTERSECT( _incumple_mtbf, _incumple_uptime ) )

-- Pct_Cumple_Uptime_inc  ·  tabla Medidas
Pct_Cumple_Uptime_inc =
VAR _hp     = 28 * 24
VAR _tec    = SELECTEDVALUE( rms_disruptions[tec], "TODOS" )
VAR _umbral = IF( _tec = "GPON", 0.998, 0.995 )
VAR _base =
    FILTER(
        CALCULATETABLE(
            SUMMARIZE( rms_disruptions, rms_disruptions[red], rms_disruptions[ciudad],
                "_ev",   CALCULATE( DISTINCTCOUNT( rms_disruptions[id] ), rms_disruptions[servicio] = "Internet" ),
                "_afec", CALCULATE( SUMX( rms_disruptions, rms_disruptions[afectacion_real] * rms_disruptions[porcentaje] / 100 ), rms_disruptions[servicio] = "Internet" ) * 24
            ),
            rms_disruptions[servicio] = "Internet"
        ),
        NOT ISBLANK( [_ev] ) && [_ev] > 0
    )
VAR _total   = COUNTROWS( _base )
VAR _cumplen = COUNTROWS( FILTER( _base, DIVIDE( _hp - [_afec], _hp ) >= _umbral ) )
RETURN DIVIDE( _cumplen, _total, BLANK() )

-- HTML_KPI_TotalEventos_dis  ·  tabla Medidas
HTML_KPI_TotalEventos_dis =
VAR _val  = [Cant_Eventos_inc]
VAR _fort = [Cant_Fortuitos_inc]
VAR _prog = [Cant_Programados_inc]
VAR _c    = "#4A0E5C"
VAR _punto = UNICHAR(183)
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border:1px solid #C9A8D8;border-top:5px solid " & _c & ";border-radius:4px;padding:16px 18px;'>"
& "<div style='font-size:12px;font-weight:700;color:#3A0A4A;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;'>Total Eventos Red</div>"
& "<div style='font-size:30px;font-weight:800;color:" & _c & ";line-height:1;margin-bottom:8px;'>" & IF(ISBLANK(_val),"-",FORMAT(_val,"#,0")) & "</div>"
& "<div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;'>"
  & "<span style='font-size:12px;font-weight:600;color:#2D2D2D;'>Servicio Internet</span>"
& "</div>"
& "<div style='background:#DEB8E6;border-radius:4px;padding:5px 10px;display:inline-block;'>"
  & "<span style='font-size:12px;font-weight:700;color:#3A0A4A;'>" & FORMAT(COALESCE(_fort,0),"#,0") & " fort " & _punto & " " & FORMAT(COALESCE(_prog,0),"#,0") & " prog</span>"
& "</div></div>"

-- HTML_KPI_MTBF_dis  ·  tabla Medidas
HTML_KPI_MTBF_dis =
VAR _val   = [MTBF_inc]
VAR _nodos = [Nodos_Incumplen_MTBF_inc]
VAR _pct   = [Pct_Cumple_MTBF_inc]
VAR _es_ok = NOT ISBLANK(_val) && _val >= 7
VAR _ca    = IF(_es_ok, "#145C2E", "#7F0000")
VAR _cb    = IF(_es_ok, "#C8E6C9", "#FFCDD2")
VAR _ct    = IF(_es_ok, "#0A3D0A", "#5C0000")
VAR _est   = IF(_es_ok, "OK", "CRITICO")
VAR _bw    = FORMAT(ROUND(COALESCE(_pct,0)*100,0),"0")
VAR _punto = UNICHAR(183)
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border:1px solid #C9A8D8;border-top:5px solid " & _ca & ";border-radius:4px;padding:16px 18px;'>"
& "<div style='font-size:12px;font-weight:700;color:#3A0A4A;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;'>MTBF promedio</div>"
& "<div style='font-size:30px;font-weight:800;color:" & _ca & ";line-height:1;margin-bottom:8px;'>" & IF(ISBLANK(_val),"-",FORMAT(_val,"0.00")) & "</div>"
& "<div style='display:flex;justify-content:space-between;margin-bottom:6px;'>"
  & "<span style='font-size:12px;font-weight:600;color:#2D2D2D;'>d" & UNICHAR(237) & "as " & _punto & " umbral > 7d</span>"
  & "<span style='font-size:13px;font-weight:700;color:" & _ct & ";'>" & IF(ISBLANK(_pct),"-",FORMAT(_pct,"0.0%")) & "</span>"
& "</div>"
& "<div style='height:5px;background:#D8B8E8;border-radius:3px;overflow:hidden;margin-bottom:8px;'><div style='height:100%;width:" & _bw & "%;background:" & _ca & ";border-radius:3px;'></div></div>"
& "<div style='display:flex;justify-content:space-between;'>"
  & "<div style='background:" & _cb & ";border-radius:4px;padding:5px 10px;'><span style='font-size:12px;font-weight:800;color:" & _ct & ";'>" & _est & "</span></div>"
  & "<span style='font-size:12px;font-weight:700;color:#3A0A4A;'>" & FORMAT(COALESCE(_nodos,0),"0") & " incumplen</span>"
& "</div></div>"

-- HTML_KPI_Uptime_dis  ·  tabla Medidas
HTML_KPI_Uptime_dis =
VAR _val   = [Uptime_inc]
VAR _tec   = SELECTEDVALUE(rms_disruptions[tec], "HFC")
VAR _umb   = IF(_tec = "GPON", 0.998, 0.995)
VAR _nodos = [Nodos_Incumplen_Uptime_inc]
VAR _pct   = [Pct_Cumple_Uptime_inc]
VAR _es_ok = NOT ISBLANK(_val) && _val >= _umb
VAR _es_al = NOT ISBLANK(_val) && _val >= (_umb - 0.01) && _val < _umb
VAR _ca    = IF(_es_ok, "#145C2E", IF(_es_al, "#7F3000", "#7F0000"))
VAR _cb    = IF(_es_ok, "#C8E6C9", IF(_es_al, "#FFE0B2", "#FFCDD2"))
VAR _ct    = IF(_es_ok, "#0A3D0A", IF(_es_al, "#5C2000", "#5C0000"))
VAR _est   = IF(_es_ok, "OK", IF(_es_al, "ALERTA", "CRITICO"))
VAR _bw    = FORMAT(ROUND(COALESCE(_pct,0)*100,0),"0")
VAR _utxt  = IF(_tec = "GPON", "> 99,8%", "> 99,5%")
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border:1px solid #C9A8D8;border-top:5px solid " & _ca & ";border-radius:4px;padding:16px 18px;'>"
& "<div style='font-size:12px;font-weight:700;color:#3A0A4A;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;'>Uptime promedio</div>"
& "<div style='font-size:30px;font-weight:800;color:" & _ca & ";line-height:1;margin-bottom:8px;'>" & IF(ISBLANK(_val),"-",FORMAT(_val,"0.00%")) & "</div>"
& "<div style='display:flex;justify-content:space-between;margin-bottom:6px;'>"
  & "<span style='font-size:12px;font-weight:600;color:#2D2D2D;'>umbral " & _utxt & "</span>"
  & "<span style='font-size:13px;font-weight:700;color:" & _ct & ";'>" & IF(ISBLANK(_pct),"-",FORMAT(_pct,"0.0%")) & "</span>"
& "</div>"
& "<div style='height:5px;background:#D8B8E8;border-radius:3px;overflow:hidden;margin-bottom:8px;'><div style='height:100%;width:" & _bw & "%;background:" & _ca & ";border-radius:3px;'></div></div>"
& "<div style='display:flex;justify-content:space-between;'>"
  & "<div style='background:" & _cb & ";border-radius:4px;padding:5px 10px;'><span style='font-size:12px;font-weight:800;color:" & _ct & ";'>" & _est & "</span></div>"
  & "<span style='font-size:12px;font-weight:700;color:#3A0A4A;'>" & FORMAT(COALESCE(_nodos,0),"0") & " ramales incumplen</span>"
& "</div></div>"

-- HTML_KPI_NodosCriticos_dis  ·  tabla Medidas
HTML_KPI_NodosCriticos_dis =
VAR _crit  = [Nodos_Criticos_inc]
VAR _mtbfn = [Nodos_Incumplen_MTBF_inc]
VAR _uptn  = [Nodos_Incumplen_Uptime_inc]
VAR _alto  = NOT ISBLANK(_crit) && _crit > 0
VAR _ca    = IF(_alto, "#7F0000", "#145C2E")
VAR _cb    = IF(_alto, "#FFCDD2", "#C8E6C9")
VAR _ct    = IF(_alto, "#5C0000", "#0A3D0A")
VAR _est   = IF(_alto, "CRITICO", "OK")
VAR _punto = UNICHAR(183)
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border:1px solid #C9A8D8;border-top:5px solid " & _ca & ";border-radius:4px;padding:16px 18px;'>"
& "<div style='font-size:12px;font-weight:700;color:#3A0A4A;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;'>Nodos cr" & UNICHAR(237) & "ticos</div>"
& "<div style='font-size:30px;font-weight:800;color:" & _ca & ";line-height:1;margin-bottom:8px;'>" & IF(ISBLANK(_crit),"-",FORMAT(_crit,"#,0")) & "</div>"
& "<div style='display:flex;justify-content:space-between;margin-bottom:8px;'>"
  & "<span style='font-size:12px;font-weight:600;color:#2D2D2D;'>incumplen MTBF y Uptime</span>"
& "</div>"
& "<div style='display:flex;justify-content:space-between;'>"
  & "<div style='background:" & _cb & ";border-radius:4px;padding:5px 10px;'><span style='font-size:12px;font-weight:800;color:" & _ct & ";'>" & _est & "</span></div>"
  & "<span style='font-size:12px;font-weight:700;color:#3A0A4A;'>MTBF: " & FORMAT(COALESCE(_mtbfn,0),"0") & " " & _punto & " UPT: " & FORMAT(COALESCE(_uptn,0),"0") & "</span>"
& "</div></div>"

-- HTML_KPI_PctMTBF_dis  ·  tabla Medidas
HTML_KPI_PctMTBF_dis =
VAR _val   = [Pct_Cumple_MTBF_inc]
VAR _nodos = [Nodos_Incumplen_MTBF_inc]
VAR _es_ok = NOT ISBLANK(_val) && _val >= 0.95
VAR _es_al = NOT ISBLANK(_val) && _val >= 0.90 && _val < 0.95
VAR _ca    = IF(_es_ok, "#145C2E", IF(_es_al, "#7F3000", "#7F0000"))
VAR _cb    = IF(_es_ok, "#C8E6C9", IF(_es_al, "#FFE0B2", "#FFCDD2"))
VAR _ct    = IF(_es_ok, "#0A3D0A", IF(_es_al, "#5C2000", "#5C0000"))
VAR _est   = IF(_es_ok, "OK", IF(_es_al, "ALERTA", "CRITICO"))
VAR _bw    = FORMAT(ROUND(COALESCE(_val,0)*100,0),"0")
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border:1px solid #C9A8D8;border-top:5px solid " & _ca & ";border-radius:4px;padding:16px 18px;'>"
& "<div style='font-size:12px;font-weight:700;color:#3A0A4A;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;'>% Cumple MTBF</div>"
& "<div style='font-size:30px;font-weight:800;color:" & _ca & ";line-height:1;margin-bottom:8px;'>" & IF(ISBLANK(_val),"-",FORMAT(_val,"0.00%")) & "</div>"
& "<div style='display:flex;justify-content:space-between;margin-bottom:6px;'>"
  & "<span style='font-size:12px;font-weight:600;color:#2D2D2D;'>nodos > 7 d" & UNICHAR(237) & "as MTBF</span>"
  & "<span style='font-size:13px;font-weight:700;color:" & _ct & ";'>" & FORMAT(COALESCE(_nodos,0),"0") & " incumplen</span>"
& "</div>"
& "<div style='height:5px;background:#D8B8E8;border-radius:3px;overflow:hidden;margin-bottom:8px;'><div style='height:100%;width:" & _bw & "%;background:" & _ca & ";border-radius:3px;'></div></div>"
& "<div style='background:" & _cb & ";border-radius:4px;padding:5px 10px;display:inline-block;'>"
  & "<span style='font-size:12px;font-weight:800;color:" & _ct & ";'>" & _est & "</span>"
& "</div></div>"

-- HTML_KPI_PctUptime_dis  ·  tabla Medidas
HTML_KPI_PctUptime_dis =
VAR _val   = [Pct_Cumple_Uptime_inc]
VAR _tec   = SELECTEDVALUE(rms_disruptions[tec], "HFC")
VAR _nodos = [Nodos_Incumplen_Uptime_inc]
VAR _es_ok = NOT ISBLANK(_val) && _val >= 0.95
VAR _es_al = NOT ISBLANK(_val) && _val >= 0.90 && _val < 0.95
VAR _ca    = IF(_es_ok, "#0C447C", IF(_es_al, "#7F3000", "#7F0000"))
VAR _cb    = IF(_es_ok, "#BBDEFB", IF(_es_al, "#FFE0B2", "#FFCDD2"))
VAR _ct    = IF(_es_ok, "#062E5C", IF(_es_al, "#5C2000", "#5C0000"))
VAR _est   = IF(_es_ok, "OK", IF(_es_al, "ALERTA", "CRITICO"))
VAR _bw    = FORMAT(ROUND(COALESCE(_val,0)*100,0),"0")
VAR _utxt  = IF(_tec = "GPON", "> 99,8%", "> 99,5%")
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border:1px solid #C9A8D8;border-top:5px solid " & _ca & ";border-radius:4px;padding:16px 18px;'>"
& "<div style='font-size:12px;font-weight:700;color:#3A0A4A;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;'>% Cumple Uptime</div>"
& "<div style='font-size:30px;font-weight:800;color:" & _ca & ";line-height:1;margin-bottom:8px;'>" & IF(ISBLANK(_val),"-",FORMAT(_val,"0.00%")) & "</div>"
& "<div style='display:flex;justify-content:space-between;margin-bottom:6px;'>"
  & "<span style='font-size:12px;font-weight:600;color:#2D2D2D;'>nodos " & _utxt & " Uptime</span>"
  & "<span style='font-size:13px;font-weight:700;color:" & _ct & ";'>" & FORMAT(COALESCE(_nodos,0),"0") & " incumplen</span>"
& "</div>"
& "<div style='height:5px;background:#D8B8E8;border-radius:3px;overflow:hidden;margin-bottom:8px;'><div style='height:100%;width:" & _bw & "%;background:" & _ca & ";border-radius:3px;'></div></div>"
& "<div style='background:" & _cb & ";border-radius:4px;padding:5px 10px;display:inline-block;'>"
  & "<span style='font-size:12px;font-weight:800;color:" & _ct & ";'>" & _est & "</span>"
& "</div></div>"

-- HTML_Heatmap_Eventos_dis  ·  tabla Medidas
HTML_Heatmap_Eventos_dis =
VAR _data =
    ADDCOLUMNS(
        CROSSJOIN(
            VALUES( rms_disruptions[Rango_Hora] ),
            VALUES( rms_disruptions[Day_dis_nombre] )
        ),
        "_ev", CALCULATE( [Cant_Eventos_inc] )
    )
VAR _max = MAXX( _data, [_ev] )
VAR _min = MINX( FILTER( _data, NOT ISBLANK([_ev]) ), [_ev] )
VAR _td = "padding:10px 6px;text-align:center;font-size:12px;font-weight:600;border:1px solid #C9A8D8;"

VAR _header =
    "<tr>"
    & "<th style='background:#6B1F7C;color:white;padding:7px 10px;font-size:11px;border:1px solid #4A1557;min-width:90px;'>Rango</th>"
    & "<th style='background:#6B1F7C;color:white;padding:7px 10px;font-size:11px;border:1px solid #4A1557;min-width:45px;'>lun</th>"
    & "<th style='background:#6B1F7C;color:white;padding:7px 10px;font-size:11px;border:1px solid #4A1557;min-width:45px;'>mar</th>"
    & "<th style='background:#6B1F7C;color:white;padding:7px 10px;font-size:11px;border:1px solid #4A1557;min-width:45px;'>mi&#233;</th>"
    & "<th style='background:#6B1F7C;color:white;padding:7px 10px;font-size:11px;border:1px solid #4A1557;min-width:45px;'>jue</th>"
    & "<th style='background:#6B1F7C;color:white;padding:7px 10px;font-size:11px;border:1px solid #4A1557;min-width:45px;'>vie</th>"
    & "<th style='background:#6B1F7C;color:white;padding:7px 10px;font-size:11px;border:1px solid #4A1557;min-width:45px;'>s&#225;b</th>"
    & "<th style='background:#6B1F7C;color:white;padding:7px 10px;font-size:11px;border:1px solid #4A1557;min-width:45px;'>dom</th>"
    & "</tr>"

// dias con tilde exactos de la columna
VAR _d_mie = "mi" & UNICHAR(233)  // mié
VAR _d_sab = "s" & UNICHAR(225) & "b"  // sáb

VAR _fila_h1 =
    VAR _h = "00:00 - 04:00"
    VAR _lun = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="lun" ), [_ev] )
    VAR _mar = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="mar" ), [_ev] )
    VAR _mie = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]=_d_mie ), [_ev] )
    VAR _jue = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="jue" ), [_ev] )
    VAR _vie = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="vie" ), [_ev] )
    VAR _sab = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]=_d_sab ), [_ev] )
    VAR _dom = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="dom" ), [_ev] )
    VAR _il=DIVIDE(COALESCE(_lun,0)-_min,_max-_min,0) VAR _im=DIVIDE(COALESCE(_mar,0)-_min,_max-_min,0) VAR _ii=DIVIDE(COALESCE(_mie,0)-_min,_max-_min,0) VAR _ij=DIVIDE(COALESCE(_jue,0)-_min,_max-_min,0) VAR _iv=DIVIDE(COALESCE(_vie,0)-_min,_max-_min,0) VAR _is=DIVIDE(COALESCE(_sab,0)-_min,_max-_min,0) VAR _id=DIVIDE(COALESCE(_dom,0)-_min,_max-_min,0)
    VAR _cl="rgb("&FORMAT(INT(243-(243-137)*_il),"0")&","&FORMAT(INT(234-(234-51)*_il),"0")&","&FORMAT(INT(247-(247-149)*_il),"0")&")" VAR _cm="rgb("&FORMAT(INT(243-(243-137)*_im),"0")&","&FORMAT(INT(234-(234-51)*_im),"0")&","&FORMAT(INT(247-(247-149)*_im),"0")&")" VAR _ci="rgb("&FORMAT(INT(243-(243-137)*_ii),"0")&","&FORMAT(INT(234-(234-51)*_ii),"0")&","&FORMAT(INT(247-(247-149)*_ii),"0")&")" VAR _cj="rgb("&FORMAT(INT(243-(243-137)*_ij),"0")&","&FORMAT(INT(234-(234-51)*_ij),"0")&","&FORMAT(INT(247-(247-149)*_ij),"0")&")" VAR _cv="rgb("&FORMAT(INT(243-(243-137)*_iv),"0")&","&FORMAT(INT(234-(234-51)*_iv),"0")&","&FORMAT(INT(247-(247-149)*_iv),"0")&")" VAR _cs="rgb("&FORMAT(INT(243-(243-137)*_is),"0")&","&FORMAT(INT(234-(234-51)*_is),"0")&","&FORMAT(INT(247-(247-149)*_is),"0")&")" VAR _cd="rgb("&FORMAT(INT(243-(243-137)*_id),"0")&","&FORMAT(INT(234-(234-51)*_id),"0")&","&FORMAT(INT(247-(247-149)*_id),"0")&")"
    VAR _tl=IF(_il>0.5,"#fff","#3C1048") VAR _tm=IF(_im>0.5,"#fff","#3C1048") VAR _ti=IF(_ii>0.5,"#fff","#3C1048") VAR _tj=IF(_ij>0.5,"#fff","#3C1048") VAR _tv=IF(_iv>0.5,"#fff","#3C1048") VAR _ts=IF(_is>0.5,"#fff","#3C1048") VAR _td2=IF(_id>0.5,"#fff","#3C1048")
    RETURN "<tr><td style='background:#F3EAF7;color:#6B1F7C;padding:7px 10px;font-size:11px;border:1px solid #C9A8D8;white-space:nowrap;'>"&_h&"</td>"
    &"<td style='"&_td&"background:"&_cl&";color:"&_tl&"'>"&IF(ISBLANK(_lun),"-",FORMAT(_lun,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cm&";color:"&_tm&"'>"&IF(ISBLANK(_mar),"-",FORMAT(_mar,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_ci&";color:"&_ti&"'>"&IF(ISBLANK(_mie),"-",FORMAT(_mie,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cj&";color:"&_tj&"'>"&IF(ISBLANK(_jue),"-",FORMAT(_jue,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cv&";color:"&_tv&"'>"&IF(ISBLANK(_vie),"-",FORMAT(_vie,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cs&";color:"&_ts&"'>"&IF(ISBLANK(_sab),"-",FORMAT(_sab,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cd&";color:"&_td2&"'>"&IF(ISBLANK(_dom),"-",FORMAT(_dom,"0"))&"</td></tr>"

VAR _fila_h2 =
    VAR _h = "04:00 - 08:00"
    VAR _lun = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="lun" ), [_ev] )
    VAR _mar = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="mar" ), [_ev] )
    VAR _mie = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]=_d_mie ), [_ev] )
    VAR _jue = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="jue" ), [_ev] )
    VAR _vie = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="vie" ), [_ev] )
    VAR _sab = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]=_d_sab ), [_ev] )
    VAR _dom = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="dom" ), [_ev] )
    VAR _il=DIVIDE(COALESCE(_lun,0)-_min,_max-_min,0) VAR _im=DIVIDE(COALESCE(_mar,0)-_min,_max-_min,0) VAR _ii=DIVIDE(COALESCE(_mie,0)-_min,_max-_min,0) VAR _ij=DIVIDE(COALESCE(_jue,0)-_min,_max-_min,0) VAR _iv=DIVIDE(COALESCE(_vie,0)-_min,_max-_min,0) VAR _is=DIVIDE(COALESCE(_sab,0)-_min,_max-_min,0) VAR _id=DIVIDE(COALESCE(_dom,0)-_min,_max-_min,0)
    VAR _cl="rgb("&FORMAT(INT(243-(243-137)*_il),"0")&","&FORMAT(INT(234-(234-51)*_il),"0")&","&FORMAT(INT(247-(247-149)*_il),"0")&")" VAR _cm="rgb("&FORMAT(INT(243-(243-137)*_im),"0")&","&FORMAT(INT(234-(234-51)*_im),"0")&","&FORMAT(INT(247-(247-149)*_im),"0")&")" VAR _ci="rgb("&FORMAT(INT(243-(243-137)*_ii),"0")&","&FORMAT(INT(234-(234-51)*_ii),"0")&","&FORMAT(INT(247-(247-149)*_ii),"0")&")" VAR _cj="rgb("&FORMAT(INT(243-(243-137)*_ij),"0")&","&FORMAT(INT(234-(234-51)*_ij),"0")&","&FORMAT(INT(247-(247-149)*_ij),"0")&")" VAR _cv="rgb("&FORMAT(INT(243-(243-137)*_iv),"0")&","&FORMAT(INT(234-(234-51)*_iv),"0")&","&FORMAT(INT(247-(247-149)*_iv),"0")&")" VAR _cs="rgb("&FORMAT(INT(243-(243-137)*_is),"0")&","&FORMAT(INT(234-(234-51)*_is),"0")&","&FORMAT(INT(247-(247-149)*_is),"0")&")" VAR _cd="rgb("&FORMAT(INT(243-(243-137)*_id),"0")&","&FORMAT(INT(234-(234-51)*_id),"0")&","&FORMAT(INT(247-(247-149)*_id),"0")&")"
    VAR _tl=IF(_il>0.5,"#fff","#3C1048") VAR _tm=IF(_im>0.5,"#fff","#3C1048") VAR _ti=IF(_ii>0.5,"#fff","#3C1048") VAR _tj=IF(_ij>0.5,"#fff","#3C1048") VAR _tv=IF(_iv>0.5,"#fff","#3C1048") VAR _ts=IF(_is>0.5,"#fff","#3C1048") VAR _td2=IF(_id>0.5,"#fff","#3C1048")
    RETURN "<tr><td style='background:#F3EAF7;color:#6B1F7C;padding:7px 10px;font-size:11px;border:1px solid #C9A8D8;white-space:nowrap;'>"&_h&"</td>"
    &"<td style='"&_td&"background:"&_cl&";color:"&_tl&"'>"&IF(ISBLANK(_lun),"-",FORMAT(_lun,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cm&";color:"&_tm&"'>"&IF(ISBLANK(_mar),"-",FORMAT(_mar,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_ci&";color:"&_ti&"'>"&IF(ISBLANK(_mie),"-",FORMAT(_mie,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cj&";color:"&_tj&"'>"&IF(ISBLANK(_jue),"-",FORMAT(_jue,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cv&";color:"&_tv&"'>"&IF(ISBLANK(_vie),"-",FORMAT(_vie,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cs&";color:"&_ts&"'>"&IF(ISBLANK(_sab),"-",FORMAT(_sab,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cd&";color:"&_td2&"'>"&IF(ISBLANK(_dom),"-",FORMAT(_dom,"0"))&"</td></tr>"

VAR _fila_h3 =
    VAR _h = "08:00 - 12:00"
    VAR _lun = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="lun" ), [_ev] )
    VAR _mar = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="mar" ), [_ev] )
    VAR _mie = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]=_d_mie ), [_ev] )
    VAR _jue = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="jue" ), [_ev] )
    VAR _vie = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="vie" ), [_ev] )
    VAR _sab = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]=_d_sab ), [_ev] )
    VAR _dom = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="dom" ), [_ev] )
    VAR _il=DIVIDE(COALESCE(_lun,0)-_min,_max-_min,0) VAR _im=DIVIDE(COALESCE(_mar,0)-_min,_max-_min,0) VAR _ii=DIVIDE(COALESCE(_mie,0)-_min,_max-_min,0) VAR _ij=DIVIDE(COALESCE(_jue,0)-_min,_max-_min,0) VAR _iv=DIVIDE(COALESCE(_vie,0)-_min,_max-_min,0) VAR _is=DIVIDE(COALESCE(_sab,0)-_min,_max-_min,0) VAR _id=DIVIDE(COALESCE(_dom,0)-_min,_max-_min,0)
    VAR _cl="rgb("&FORMAT(INT(243-(243-137)*_il),"0")&","&FORMAT(INT(234-(234-51)*_il),"0")&","&FORMAT(INT(247-(247-149)*_il),"0")&")" VAR _cm="rgb("&FORMAT(INT(243-(243-137)*_im),"0")&","&FORMAT(INT(234-(234-51)*_im),"0")&","&FORMAT(INT(247-(247-149)*_im),"0")&")" VAR _ci="rgb("&FORMAT(INT(243-(243-137)*_ii),"0")&","&FORMAT(INT(234-(234-51)*_ii),"0")&","&FORMAT(INT(247-(247-149)*_ii),"0")&")" VAR _cj="rgb("&FORMAT(INT(243-(243-137)*_ij),"0")&","&FORMAT(INT(234-(234-51)*_ij),"0")&","&FORMAT(INT(247-(247-149)*_ij),"0")&")" VAR _cv="rgb("&FORMAT(INT(243-(243-137)*_iv),"0")&","&FORMAT(INT(234-(234-51)*_iv),"0")&","&FORMAT(INT(247-(247-149)*_iv),"0")&")" VAR _cs="rgb("&FORMAT(INT(243-(243-137)*_is),"0")&","&FORMAT(INT(234-(234-51)*_is),"0")&","&FORMAT(INT(247-(247-149)*_is),"0")&")" VAR _cd="rgb("&FORMAT(INT(243-(243-137)*_id),"0")&","&FORMAT(INT(234-(234-51)*_id),"0")&","&FORMAT(INT(247-(247-149)*_id),"0")&")"
    VAR _tl=IF(_il>0.5,"#fff","#3C1048") VAR _tm=IF(_im>0.5,"#fff","#3C1048") VAR _ti=IF(_ii>0.5,"#fff","#3C1048") VAR _tj=IF(_ij>0.5,"#fff","#3C1048") VAR _tv=IF(_iv>0.5,"#fff","#3C1048") VAR _ts=IF(_is>0.5,"#fff","#3C1048") VAR _td2=IF(_id>0.5,"#fff","#3C1048")
    RETURN "<tr><td style='background:#F3EAF7;color:#6B1F7C;padding:7px 10px;font-size:11px;border:1px solid #C9A8D8;white-space:nowrap;'>"&_h&"</td>"
    &"<td style='"&_td&"background:"&_cl&";color:"&_tl&"'>"&IF(ISBLANK(_lun),"-",FORMAT(_lun,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cm&";color:"&_tm&"'>"&IF(ISBLANK(_mar),"-",FORMAT(_mar,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_ci&";color:"&_ti&"'>"&IF(ISBLANK(_mie),"-",FORMAT(_mie,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cj&";color:"&_tj&"'>"&IF(ISBLANK(_jue),"-",FORMAT(_jue,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cv&";color:"&_tv&"'>"&IF(ISBLANK(_vie),"-",FORMAT(_vie,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cs&";color:"&_ts&"'>"&IF(ISBLANK(_sab),"-",FORMAT(_sab,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cd&";color:"&_td2&"'>"&IF(ISBLANK(_dom),"-",FORMAT(_dom,"0"))&"</td></tr>"

VAR _fila_h4 =
    VAR _h = "12:00 - 16:00"
    VAR _lun = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="lun" ), [_ev] )
    VAR _mar = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="mar" ), [_ev] )
    VAR _mie = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]=_d_mie ), [_ev] )
    VAR _jue = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="jue" ), [_ev] )
    VAR _vie = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="vie" ), [_ev] )
    VAR _sab = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]=_d_sab ), [_ev] )
    VAR _dom = MAXX( FILTER( _data, rms_disruptions[Rango_Hora]=_h && rms_disruptions[Day_dis_nombre]="dom" ), [_ev] )
    VAR _il=DIVIDE(COALESCE(_lun,0)-_min,_max-_min,0) VAR _im=DIVIDE(COALESCE(_mar,0)-_min,_max-_min,0) VAR _ii=DIVIDE(COALESCE(_mie,0)-_min,_max-_min,0) VAR _ij=DIVIDE(COALESCE(_jue,0)-_min,_max-_min,0) VAR _iv=DIVIDE(COALESCE(_vie,0)-_min,_max-_min,0) VAR _is=DIVIDE(COALESCE(_sab,0)-_min,_max-_min,0) VAR _id=DIVIDE(COALESCE(_dom,0)-_min,_max-_min,0)
    VAR _cl="rgb("&FORMAT(INT(243-(243-137)*_il),"0")&","&FORMAT(INT(234-(234-51)*_il),"0")&","&FORMAT(INT(247-(247-149)*_il),"0")&")" VAR _cm="rgb("&FORMAT(INT(243-(243-137)*_im),"0")&","&FORMAT(INT(234-(234-51)*_im),"0")&","&FORMAT(INT(247-(247-149)*_im),"0")&")" VAR _ci="rgb("&FORMAT(INT(243-(243-137)*_ii),"0")&","&FORMAT(INT(234-(234-51)*_ii),"0")&","&FORMAT(INT(247-(247-149)*_ii),"0")&")" VAR _cj="rgb("&FORMAT(INT(243-(243-137)*_ij),"0")&","&FORMAT(INT(234-(234-51)*_ij),"0")&","&FORMAT(INT(247-(247-149)*_ij),"0")&")" VAR _cv="rgb("&FORMAT(INT(243-(243-137)*_iv),"0")&","&FORMAT(INT(234-(234-51)*_iv),"0")&","&FORMAT(INT(247-(247-149)*_iv),"0")&")" VAR _cs="rgb("&FORMAT(INT(243-(243-137)*_is),"0")&","&FORMAT(INT(234-(234-51)*_is),"0")&","&FORMAT(INT(247-(247-149)*_is),"0")&")" VAR _cd="rgb("&FORMAT(INT(243-(243-137)*_id),"0")&","&FORMAT(INT(234-(234-51)*_id),"0")&","&FORMAT(INT(247-(247-149)*_id),"0")&")"
    VAR _tl=IF(_il>0.5,"#fff","#3C1048") VAR _tm=IF(_im>0.5,"#fff","#3C1048") VAR _ti=IF(_ii>0.5,"#fff","#3C1048") VAR _tj=IF(_ij>0.5,"#fff","#3C1048") VAR _tv=IF(_iv>0.5,"#fff","#3C1048") VAR _ts=IF(_is>0.5,"#fff","#3C1048") VAR _td2=IF(_id>0.5,"#fff","#3C1048")
    RETURN "<tr><td style='background:#F3EAF7;color:#6B1F7C;padding:7px 10px;font-size:11px;border:1px solid #C9A8D8;white-space:nowrap;'>"&_h&"</td>"
    &"<td style='"&_td&"background:"&_cl&";color:"&_tl&"'>"&IF(ISBLANK(_lun),"-",FORMAT(_lun,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cm&";color:"&_tm&"'>"&IF(ISBLANK(_mar),"-",FORMAT(_mar,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_ci&";color:"&_ti&"'>"&IF(ISBLANK(_mie),"-",FORMAT(_mie,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cj&";color:"&_tj&"'>"&IF(ISBLANK(_jue),"-",FORMAT(_jue,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cv&";color:"&_tv&"'>"&IF(ISBLANK(_vie),"-",FORMAT(_vie,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cs&";color:"&_ts&"'>"&IF(ISBLANK(_sab),"-",FORMAT(_sab,"0"))&"</td>"
    &"<td style='"&_td&"background:"&_cd&";color:"&_td2&"'>"&IF(ISBLANK(_dom),"-",FORMAT(_dom,"0"))&"</td></tr>"


    )
)

-- Var_Indice_UltimoMesConDatos  ·  tabla Medidas
Var_Indice_UltimoMesConDatos =
VAR _MesActual =
    MAX('Calendar'[YearMonth])

VAR _UltimoMesConDatos =
    MAXX(
        FILTER(
            ALLSELECTED('Calendar'[YearMonth]),
            CALCULATE( NOT ISBLANK([Indice retencion]) )
        ),
        'Calendar'[YearMonth]
    )

VAR _Actual = [Indice retencion]
VAR _Anterior = [Indice_Mes_Anterior]

RETURN
    IF(
        _MesActual = _UltimoMesConDatos,
        IF(
            ISBLANK(_Actual) || ISBLANK(_Anterior),
            BLANK(),
            _Actual - _Anterior
        ),
        BLANK()
    )

-- Indice_Mes_Anterior  ·  tabla Medidas
Indice_Mes_Anterior =
VAR _minFecha = MIN('Calendar'[Date])
VAR _maxFecha = MAX('Calendar'[Date])
VAR _esMesCompleto = CALCULATE(COUNTROWS('Calendar')) = DAY(EOMONTH(_minFecha, 0))
VAR _fechaIniAnt = IF(_esMesCompleto,
    EOMONTH(_minFecha, -1) - DAY(EOMONTH(_minFecha, -1)) + 1,
    DATE(YEAR(_minFecha), MONTH(_minFecha) - 1, 1))
VAR _fechaFinAnt = IF(_esMesCompleto,
    EOMONTH(_minFecha, -1),
    DATE(YEAR(_maxFecha), MONTH(_maxFecha) - 1, DAY(_maxFecha)))
RETURN
CALCULATE(
    DIVIDE(
        CALCULATE(COUNTROWS('tickets_deserciones'), 'tickets_deserciones'[Retencion] = "SI"),
        COUNTROWS('tickets_deserciones'),
        0
    ),
    ALL('Calendar'),
    'Calendar'[Date] >= _fechaIniAnt,
    'Calendar'[Date] <= _fechaFinAnt,
    'tickets_deserciones'[es_excluido] = FALSE()
)

-- Indice retencion_1  ·  tabla Medidas
Indice retencion_1 =
VAR _total =
    CALCULATE(
        COUNTROWS('tickets_deserciones'),
        'tickets_deserciones'[es_excluido] = FALSE()
    )
VAR _retenidos =
    CALCULATE(
        COUNTROWS('tickets_deserciones'),
        FILTER(
            'tickets_deserciones',
            'tickets_deserciones'[Retencion] = "SI"
                && 'tickets_deserciones'[es_excluido] = FALSE()
        )
    )
RETURN
    IF(
        _total = 0,
        BLANK(),
        DIVIDE(COALESCE(_retenidos,0), _total, 0)
    )

-- Meta_Mes_Call  ·  tabla Medidas
Meta_Mes_Call =
IF(
    ISINSCOPE(tickets_deserciones[Ciudad_mod]),
    VAR _minFecha = CALCULATE(MIN('Calendar'[Date]))
    VAR _minMes = DATE(YEAR(_minFecha), MONTH(_minFecha), 1)
    VAR _maxMes = EOMONTH(_minFecha, 0)
    RETURN
        CALCULATE(
            MAX('vw_file_presupuesto_retenciones'[META_INDICE_RETENCION]),
            ALL('Calendar'),
            'vw_file_presupuesto_retenciones'[FECHA_EVALUACION] >= _minMes,
            'vw_file_presupuesto_retenciones'[FECHA_EVALUACION] <= _maxMes,
            'vw_file_presupuesto_retenciones'[TIPO] = "CallCenter"
        ),
    BLANK()
)

-- HRet_Total_Retenidos  ·  tabla Medidas
HRet_Total_Retenidos =
DISTINCTCOUNT('retenciones_beneficios'[Cuenta])

-- HRet_Total_Solicitudes  ·  tabla Medidas
HRet_Total_Solicitudes =

VAR _denNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _pct = DIVIDE(_cnt, _denOld + _denNew, 0)
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fef9f9;border-radius:8px;border:1px solid #fde8e8;border-left:4px solid #C0392B;padding:14px 16px;box-sizing:border-box;height:100%'>

  <div style='font-size:15px;color:#111;margin-top:4px'>Herramientas con disminución</div>
</div>"

-- HTML_Card_Mantiene  ·  tabla Medidas
HTML_Card_Mantiene =
VAR _cnt = [HRet_Clientes_Mantienen]
VAR _denOld = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _denNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _pct = DIVIDE(_cnt, _denOld + _denNew, 0)
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fafafa;border-radius:8px;border:1px solid #e0e0e0;border-left:4px solid #888;padding:14px 16px;box-sizing:border-box;height:100%'>

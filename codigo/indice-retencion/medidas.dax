VAR _denNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), ALL('retenciones_beneficios'[MOTIVO_REAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))

-- HRet_Pct_Herramienta_1  ·  tabla Medidas
HRet_Pct_Herramienta_1 =
VAR _numOld = CALCULATE(COUNTROWS('retenciones_beneficios'), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _numNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _denOld = CALCULATE(COUNTROWS('retenciones_beneficios'), ALL('retenciones_beneficios'[Herramienta_Normalizada]), ALL('retenciones_beneficios'[beneficios]), ALL('retenciones_beneficios'[PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _denNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), ALL('retenciones_beneficios'[Herramienta_Normalizada]), ALL('retenciones_beneficios'[beneficios]), ALL('retenciones_beneficios'[PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
RETURN DIVIDE(_numOld + _numNew, _denOld + _denNew, 0)


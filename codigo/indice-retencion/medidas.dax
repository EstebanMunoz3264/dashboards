VAR _minAnt   = DATE(YEAR(_minFecha), MONTH(_minFecha) - 1, 1)
VAR _maxAnt   = IF(_todosDias, EOMONTH(_minFecha, -1), DATE(YEAR(_minFecha), MONTH(_minFecha) - 1, _diaMax))
VAR _valor =
    CALCULATE(COUNTROWS('tickets_deserciones'), 'tickets_deserciones'[Retencion] = "SI", 'tickets_deserciones'[es_excluido] = FALSE())
VAR _anterior =
    CALCULATE(
        COUNTROWS('tickets_deserciones'),
        'tickets_deserciones'[Retencion] = "SI",
        'tickets_deserciones'[es_excluido] = FALSE(),
        ALL('Calendar'),
        'Calendar'[Date] >= _minAnt,
        'Calendar'[Date] <= _maxAnt
    )
VAR _delta    = _valor - _anterior
VAR _signo    = IF(_delta >= 0, "+", "")
VAR _color    = IF(_delta >= 0, "#5A9E6F", "#C0392B")
VAR _arrow    = IF(_delta >= 0, "▲", "▼")
VAR _bgdelta  = IF(_delta >= 0, "#d0ecd8", "#f5d0d0")
VAR _valorFmt = FORMAT(_valor, "#,0")
VAR _antFmt   = FORMAT(_anterior, "#,0")
VAR _deltaFmt = FORMAT(ABS(_delta), "#,0")
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border-radius:8px;border:1px solid #E8DCEA;border-left:4px solid #5A9E6F;padding:16px 18px 12px;box-shadow:0 2px 8px rgba(90,158,111,0.08);height:100%;box-sizing:border-box;display:flex;flex-direction:column;justify-content:space-between;'>" &
"<div style='font-size:16px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:#000000;margin-bottom:6px;'>Total Retenidos</div>" &
"<div style='font-size:40px;font-weight:700;color:#5A9E6F;letter-spacing:-1px;line-height:1;margin-bottom:10px;'>" & _valorFmt & "</div>" &
"<div style='border-top:1px solid #E8DCEA;padding-top:8px;display:flex;align-items:center;justify-content:space-between;'>" &
"<div style='display:flex;align-items:center;gap:5px;'>" &
"<span style='background:" & _bgdelta & ";color:" & _color & ";border-radius:50%;width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;'>" & _arrow & "</span>" &
"<span style='font-size:18px;font-weight:600;color:" & _color & ";'>" & _signo & _deltaFmt & " vs mes ant.</span>" &
"</div>" &
"<span style='font-size:16px;color:#000000;'>Ant: " & _antFmt & "</span>" &
"</div>" &
"</div>"

-- HTML_KPI_NoRetenidos1  ·  tabla Medidas
HTML_KPI_NoRetenidos1 =
VAR _minFecha = CALCULATE(MIN('Calendar'[Date]))
VAR _maxFecha = CALCULATE(MAX('Calendar'[Date]))
VAR _diaMax   = DAY(_maxFecha)
VAR _diasEnMes = DAY(EOMONTH(_minFecha, 0))
VAR _todosDias = CALCULATE(COUNTROWS('Calendar')) = _diasEnMes
VAR _minAnt   = DATE(YEAR(_minFecha), MONTH(_minFecha) - 1, 1)
VAR _maxAnt   = IF(_todosDias, EOMONTH(_minFecha, -1), DATE(YEAR(_minFecha), MONTH(_minFecha) - 1, _diaMax))
VAR _valor =
    CALCULATE(COUNTROWS('tickets_deserciones'), 'tickets_deserciones'[Retencion] = "NO", 'tickets_deserciones'[es_excluido] = FALSE())
VAR _anterior =
    CALCULATE(
        COUNTROWS('tickets_deserciones'),
        'tickets_deserciones'[Retencion] = "NO",
        'tickets_deserciones'[es_excluido] = FALSE(),
        ALL('Calendar'),
        'Calendar'[Date] >= _minAnt,
        'Calendar'[Date] <= _maxAnt
    )
VAR _delta    = _valor - _anterior
VAR _signo    = IF(_delta >= 0, "+", "")
VAR _color    = IF(_delta <= 0, "#5A9E6F", "#C0392B")
VAR _arrow    = IF(_delta <= 0, "▼", "▲")
VAR _bgdelta  = IF(_delta <= 0, "#d0ecd8", "#f5d0d0")
VAR _valorFmt = FORMAT(_valor, "#,0")
VAR _antFmt   = FORMAT(_anterior, "#,0")
VAR _deltaFmt = FORMAT(ABS(_delta), "#,0")
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border-radius:8px;border:1px solid #E8DCEA;border-left:4px solid #C0392B;padding:16px 18px 12px;box-shadow:0 2px 8px rgba(192,57,43,0.08);height:100%;box-sizing:border-box;display:flex;flex-direction:column;justify-content:space-between;'>" &
"<div style='font-size:16px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:#000000;margin-bottom:6px;'>No Retenidos</div>" &
"<div style='font-size:40px;font-weight:700;color:#C0392B;letter-spacing:-1px;line-height:1;margin-bottom:10px;'>" & _valorFmt & "</div>" &

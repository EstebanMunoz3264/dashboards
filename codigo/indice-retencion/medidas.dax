"</div>" &
"</div>"

-- HTML_KPI_Indice1  ·  tabla Medidas
HTML_KPI_Indice1 =
VAR _minFecha = CALCULATE(MIN('Calendar'[Date]))
VAR _maxFecha = CALCULATE(MAX('Calendar'[Date]))
VAR _diaMax   = DAY(_maxFecha)
VAR _diasEnMes = DAY(EOMONTH(_minFecha, 0))
VAR _todosDias = CALCULATE(COUNTROWS('Calendar')) = _diasEnMes
VAR _minAnt   = DATE(YEAR(_minFecha), MONTH(_minFecha) - 1, 1)
VAR _maxAnt   = IF(_todosDias, EOMONTH(_minFecha, -1), DATE(YEAR(_minFecha), MONTH(_minFecha) - 1, _diaMax))
VAR _valor =
    DIVIDE(
        CALCULATE(COUNTROWS('tickets_deserciones'), 'tickets_deserciones'[Retencion] = "SI", 'tickets_deserciones'[es_excluido] = FALSE()),
        CALCULATE(COUNTROWS('tickets_deserciones'), 'tickets_deserciones'[es_excluido] = FALSE()),
        0
    )
VAR _retenidosAnt =
    CALCULATE(
        COUNTROWS('tickets_deserciones'),
        'tickets_deserciones'[Retencion] = "SI",
        'tickets_deserciones'[es_excluido] = FALSE(),
        ALL('Calendar'),
        'Calendar'[Date] >= _minAnt,
        'Calendar'[Date] <= _maxAnt
    )
VAR _totalAnt =
    CALCULATE(
        COUNTROWS('tickets_deserciones'),
        'tickets_deserciones'[es_excluido] = FALSE(),
        ALL('Calendar'),
        'Calendar'[Date] >= _minAnt,
        'Calendar'[Date] <= _maxAnt
    )
VAR _anterior = DIVIDE(_retenidosAnt, _totalAnt, 0)
VAR _delta    = (_valor - _anterior) * 100
VAR _signo    = IF(_delta >= 0, "+", "")
VAR _color    = IF(_delta >= 0, "#5A9E6F", "#C0392B")
VAR _arrow    = IF(_delta >= 0, "▲", "▼")
VAR _bgdelta  = IF(_delta >= 0, "#d0ecd8", "#f5d0d0")
VAR _pct      = FORMAT(_valor, "0.0%")
VAR _antPct   = FORMAT(_anterior, "0.0%")
VAR _deltaPct = SUBSTITUTE(FORMAT(ABS(_delta), "0.0"), ",", ".")
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border-radius:8px;border:1px solid #E8DCEA;border-left:4px solid #783E80;padding:16px 18px 12px;box-shadow:0 2px 8px rgba(201,143,212,0.08);height:100%;box-sizing:border-box;display:flex;flex-direction:column;justify-content:space-between;'>" &
"<div style='font-size:16px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:#000000;margin-bottom:6px;'>Indice de Retencion</div>" &
"<div style='font-size:40px;font-weight:700;color:#783E80;letter-spacing:-1px;line-height:1;margin-bottom:10px;'>" & _pct & "</div>" &
"<div style='border-top:1px solid #E8DCEA;padding-top:8px;display:flex;align-items:center;justify-content:space-between;'>" &
"<div style='display:flex;align-items:center;gap:5px;'>" &
"<span style='background:" & _bgdelta & ";color:" & _color & ";border-radius:50%;width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;'>" & _arrow & "</span>" &
"<span style='font-size:18px;font-weight:600;color:" & _color & ";'>" & _signo & _deltaPct & " pp vs mes ant.</span>" &
"</div>" &
"<span style='font-size:16px;color:#000000;'>Ant: <span style='font-weight:600;color:#000000;'>" & _antPct & "</span></span>" &
"</div>" &
"</div>"

-- HTML_Histograma_Efectividad_agencia  ·  tabla Medidas
HTML_Histograma_Efectividad_agencia =
VAR _Tabla =
    ADDCOLUMNS(
        CALCULATETABLE(
            VALUES('tickets_deserciones'[Agent]),
            'tickets_deserciones'[Departamento] = "Agencia",
            'tickets_deserciones'[es_excluido] = FALSE()
        ),
        "@efectividad",
        DIVIDE(
            CALCULATE(
                COUNTROWS('tickets_deserciones'),
                'tickets_deserciones'[Retencion] = "SI",
                'tickets_deserciones'[es_excluido] = FALSE(),
                'tickets_deserciones'[Departamento] = "Agencia"
            ),
            CALCULATE(
                COUNTROWS('tickets_deserciones'),
                'tickets_deserciones'[es_excluido] = FALSE(),
                'tickets_deserciones'[Departamento] = "Agencia"
            ),
            0
        )
    )

VAR _R1  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0   && [@efectividad] < 0.1))
VAR _R2  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.1 && [@efectividad] < 0.2))
VAR _R3  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.2 && [@efectividad] < 0.3))
VAR _R4  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.3 && [@efectividad] < 0.4))
VAR _R5  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.4 && [@efectividad] < 0.5))
VAR _R6  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.5 && [@efectividad] < 0.6))
VAR _R7  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.6 && [@efectividad] < 0.7))
VAR _R8  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.7 && [@efectividad] < 0.8))
VAR _R9  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.8 && [@efectividad] < 0.9))
VAR _R10 = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.9 && [@efectividad] <= 1))

VAR _Max   = MAXX({_R1,_R2,_R3,_R4,_R5,_R6,_R7,_R8,_R9,_R10}, [Value])
VAR _Total = _R1+_R2+_R3+_R4+_R5+_R6+_R7+_R8+_R9+_R10

VAR _H1  = IF(_Max > 0, DIVIDE(_R1,  _Max) * 120, 0)
VAR _H2  = IF(_Max > 0, DIVIDE(_R2,  _Max) * 120, 0)
VAR _H3  = IF(_Max > 0, DIVIDE(_R3,  _Max) * 120, 0)
VAR _H4  = IF(_Max > 0, DIVIDE(_R4,  _Max) * 120, 0)
VAR _H5  = IF(_Max > 0, DIVIDE(_R5,  _Max) * 120, 0)
VAR _H6  = IF(_Max > 0, DIVIDE(_R6,  _Max) * 120, 0)
VAR _H7  = IF(_Max > 0, DIVIDE(_R7,  _Max) * 120, 0)
VAR _H8  = IF(_Max > 0, DIVIDE(_R8,  _Max) * 120, 0)
VAR _H9  = IF(_Max > 0, DIVIDE(_R9,  _Max) * 120, 0)
VAR _H10 = IF(_Max > 0, DIVIDE(_R10, _Max) * 120, 0)

VAR _bW   = 34
VAR _gap  = 12
VAR _base = 130

VAR _x1  = 20
VAR _x2  = _x1  + _bW + _gap
VAR _x3  = _x2  + _bW + _gap
VAR _x4  = _x3  + _bW + _gap
VAR _x5  = _x4  + _bW + _gap
VAR _x6  = _x5  + _bW + _gap
VAR _x7  = _x6  + _bW + _gap
VAR _x8  = _x7  + _bW + _gap
VAR _x9  = _x8  + _bW + _gap
VAR _x10 = _x9  + _bW + _gap

VAR _c1  = "#c9a8e8"
VAR _c2  = "#b890d8"
VAR _c3  = "#a478c8"
VAR _c4  = "#9060b8"
VAR _c5  = "#7b4fa6"
VAR _c6  = "#6a3d96"
VAR _c7  = "#5a2d86"
VAR _c8  = "#4a1e76"
VAR _c9  = "#3b1f5e"
VAR _c10 = "#2a0f4e"

RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#ffffff;padding:10px 16px 8px;width:100%;box-sizing:border-box'>" &
"<div style='text-align:center;color:#333;font-size:16px;font-weight:700;margin-bottom:12px'>DISTRIBUCION DE ASESORES POR RANGO DE EFECTIVIDAD AGENCIA</div>" &
"<svg width='100%' viewBox='0 0 500 160' xmlns='http://www.w3.org/2000/svg'>" &
"<rect x='" & _x1  & "' y='" & (_base-_H1)  & "' width='" & _bW & "' height='" & _H1  & "' fill='" & _c1  & "' rx='2'/>" &
"<rect x='" & _x2  & "' y='" & (_base-_H2)  & "' width='" & _bW & "' height='" & _H2  & "' fill='" & _c2  & "' rx='2'/>" &
"<rect x='" & _x3  & "' y='" & (_base-_H3)  & "' width='" & _bW & "' height='" & _H3  & "' fill='" & _c3  & "' rx='2'/>" &
"<rect x='" & _x4  & "' y='" & (_base-_H4)  & "' width='" & _bW & "' height='" & _H4  & "' fill='" & _c4  & "' rx='2'/>" &
"<rect x='" & _x5  & "' y='" & (_base-_H5)  & "' width='" & _bW & "' height='" & _H5  & "' fill='" & _c5  & "' rx='2'/>" &
"<rect x='" & _x6  & "' y='" & (_base-_H6)  & "' width='" & _bW & "' height='" & _H6  & "' fill='" & _c6  & "' rx='2'/>" &
"<rect x='" & _x7  & "' y='" & (_base-_H7)  & "' width='" & _bW & "' height='" & _H7  & "' fill='" & _c7  & "' rx='2'/>" &
"<rect x='" & _x8  & "' y='" & (_base-_H8)  & "' width='" & _bW & "' height='" & _H8  & "' fill='" & _c8  & "' rx='2'/>" &
"<rect x='" & _x9  & "' y='" & (_base-_H9)  & "' width='" & _bW & "' height='" & _H9  & "' fill='" & _c9  & "' rx='2'/>" &
"<rect x='" & _x10 & "' y='" & (_base-_H10) & "' width='" & _bW & "' height='" & _H10 & "' fill='" & _c10 & "' rx='2'/>" &
"<text x='" & (_x1 +_bW/2) & "' y='" & IF(_H1  < 20, _base-_H1 -5, _base-_H1 +14) & "' text-anchor='middle' fill='" & IF(_H1  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R1  & "</text>" &
"<text x='" & (_x2 +_bW/2) & "' y='" & IF(_H2  < 20, _base-_H2 -5, _base-_H2 +14) & "' text-anchor='middle' fill='" & IF(_H2  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R2  & "</text>" &
"<text x='" & (_x3 +_bW/2) & "' y='" & IF(_H3  < 20, _base-_H3 -5, _base-_H3 +14) & "' text-anchor='middle' fill='" & IF(_H3  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R3  & "</text>" &
"<text x='" & (_x4 +_bW/2) & "' y='" & IF(_H4  < 20, _base-_H4 -5, _base-_H4 +14) & "' text-anchor='middle' fill='" & IF(_H4  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R4  & "</text>" &
"<text x='" & (_x5 +_bW/2) & "' y='" & IF(_H5  < 20, _base-_H5 -5, _base-_H5 +14) & "' text-anchor='middle' fill='" & IF(_H5  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R5  & "</text>" &
"<text x='" & (_x6 +_bW/2) & "' y='" & IF(_H6  < 20, _base-_H6 -5, _base-_H6 +14) & "' text-anchor='middle' fill='" & IF(_H6  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R6  & "</text>" &
"<text x='" & (_x7 +_bW/2) & "' y='" & IF(_H7  < 20, _base-_H7 -5, _base-_H7 +14) & "' text-anchor='middle' fill='" & IF(_H7  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R7  & "</text>" &
"<text x='" & (_x8 +_bW/2) & "' y='" & IF(_H8  < 20, _base-_H8 -5, _base-_H8 +14) & "' text-anchor='middle' fill='" & IF(_H8  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R8  & "</text>" &
"<text x='" & (_x9 +_bW/2) & "' y='" & IF(_H9  < 20, _base-_H9 -5, _base-_H9 +14) & "' text-anchor='middle' fill='" & IF(_H9  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R9  & "</text>" &
"<text x='" & (_x10+_bW/2) & "' y='" & IF(_H10 < 20, _base-_H10-5, _base-_H10+14) & "' text-anchor='middle' fill='" & IF(_H10 < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R10 & "</text>" &
"<line x1='20' y1='" & _base & "' x2='480' y2='" & _base & "' stroke='#dddddd' stroke-width='1'/>" &
"<text x='" & (_x1 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>0-10%</text>" &
"<text x='" & (_x2 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>10-20%</text>" &
"<text x='" & (_x3 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>20-30%</text>" &
"<text x='" & (_x4 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>30-40%</text>" &
"<text x='" & (_x5 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>40-50%</text>" &
"<text x='" & (_x6 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>50-60%</text>" &
"<text x='" & (_x7 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>60-70%</text>" &
"<text x='" & (_x8 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>70-80%</text>" &
"<text x='" & (_x9 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>80-90%</text>" &
"<text x='" & (_x10+_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>90-100%</text>" &
"</svg>" &
"<div style='text-align:right;color:#000000;font-size:18px;margin-top:2px'>Total asesores: " & _Total & "</div>" &
"</div>"

-- HTML_Histograma_Efectividad_callcenter  ·  tabla Medidas
HTML_Histograma_Efectividad_callcenter =
VAR _Tabla =
    ADDCOLUMNS(
        CALCULATETABLE(
            VALUES('tickets_deserciones'[Agent]),
            'tickets_deserciones'[Departamento] = "CallCenter",
            'tickets_deserciones'[es_excluido] = FALSE()
        ),
        "@efectividad",
        DIVIDE(
            CALCULATE(
                COUNTROWS('tickets_deserciones'),
                'tickets_deserciones'[Retencion] = "SI",
                'tickets_deserciones'[es_excluido] = FALSE(),
                'tickets_deserciones'[Departamento] = "CallCenter"
            ),
            CALCULATE(
                COUNTROWS('tickets_deserciones'),
                'tickets_deserciones'[es_excluido] = FALSE(),
                'tickets_deserciones'[Departamento] = "CallCenter"
            ),
            0
        )
    )

VAR _R1  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0   && [@efectividad] < 0.1))
VAR _R2  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.1 && [@efectividad] < 0.2))
VAR _R3  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.2 && [@efectividad] < 0.3))
VAR _R4  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.3 && [@efectividad] < 0.4))
VAR _R5  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.4 && [@efectividad] < 0.5))
VAR _R6  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.5 && [@efectividad] < 0.6))
VAR _R7  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.6 && [@efectividad] < 0.7))
VAR _R8  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.7 && [@efectividad] < 0.8))
VAR _R9  = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.8 && [@efectividad] < 0.9))
VAR _R10 = COUNTROWS(FILTER(_Tabla, [@efectividad] >= 0.9 && [@efectividad] <= 1))

VAR _Max   = MAXX({_R1,_R2,_R3,_R4,_R5,_R6,_R7,_R8,_R9,_R10}, [Value])
VAR _Total = _R1+_R2+_R3+_R4+_R5+_R6+_R7+_R8+_R9+_R10

VAR _H1  = IF(_Max > 0, DIVIDE(_R1,  _Max) * 120, 0)
VAR _H2  = IF(_Max > 0, DIVIDE(_R2,  _Max) * 120, 0)
VAR _H3  = IF(_Max > 0, DIVIDE(_R3,  _Max) * 120, 0)
VAR _H4  = IF(_Max > 0, DIVIDE(_R4,  _Max) * 120, 0)
VAR _H5  = IF(_Max > 0, DIVIDE(_R5,  _Max) * 120, 0)
VAR _H6  = IF(_Max > 0, DIVIDE(_R6,  _Max) * 120, 0)
VAR _H7  = IF(_Max > 0, DIVIDE(_R7,  _Max) * 120, 0)
VAR _H8  = IF(_Max > 0, DIVIDE(_R8,  _Max) * 120, 0)
VAR _H9  = IF(_Max > 0, DIVIDE(_R9,  _Max) * 120, 0)
VAR _H10 = IF(_Max > 0, DIVIDE(_R10, _Max) * 120, 0)

VAR _bW   = 34
VAR _gap  = 12
VAR _base = 130

VAR _x1  = 20
VAR _x2  = _x1  + _bW + _gap
VAR _x3  = _x2  + _bW + _gap
VAR _x4  = _x3  + _bW + _gap
VAR _x5  = _x4  + _bW + _gap
VAR _x6  = _x5  + _bW + _gap
VAR _x7  = _x6  + _bW + _gap
VAR _x8  = _x7  + _bW + _gap
VAR _x9  = _x8  + _bW + _gap
VAR _x10 = _x9  + _bW + _gap

VAR _c1  = "#c9a8e8"
VAR _c2  = "#b890d8"
VAR _c3  = "#a478c8"
VAR _c4  = "#9060b8"
VAR _c5  = "#7b4fa6"
VAR _c6  = "#6a3d96"
VAR _c7  = "#5a2d86"
VAR _c8  = "#4a1e76"
VAR _c9  = "#3b1f5e"
VAR _c10 = "#2a0f4e"

RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#ffffff;padding:10px 16px 8px;width:100%;box-sizing:border-box'>" &
"<div style='text-align:center;color:#333;font-size:16px;font-weight:700;margin-bottom:12px'>DISTRIBUCION DE ASESORES POR RANGO DE EFECTIVIDAD CALL CENTER</div>" &
"<svg width='100%' viewBox='0 0 500 160' xmlns='http://www.w3.org/2000/svg'>" &
"<rect x='" & _x1  & "' y='" & (_base-_H1)  & "' width='" & _bW & "' height='" & _H1  & "' fill='" & _c1  & "' rx='2'/>" &
"<rect x='" & _x2  & "' y='" & (_base-_H2)  & "' width='" & _bW & "' height='" & _H2  & "' fill='" & _c2  & "' rx='2'/>" &
"<rect x='" & _x3  & "' y='" & (_base-_H3)  & "' width='" & _bW & "' height='" & _H3  & "' fill='" & _c3  & "' rx='2'/>" &
"<rect x='" & _x4  & "' y='" & (_base-_H4)  & "' width='" & _bW & "' height='" & _H4  & "' fill='" & _c4  & "' rx='2'/>" &
"<rect x='" & _x5  & "' y='" & (_base-_H5)  & "' width='" & _bW & "' height='" & _H5  & "' fill='" & _c5  & "' rx='2'/>" &
"<rect x='" & _x6  & "' y='" & (_base-_H6)  & "' width='" & _bW & "' height='" & _H6  & "' fill='" & _c6  & "' rx='2'/>" &
"<rect x='" & _x7  & "' y='" & (_base-_H7)  & "' width='" & _bW & "' height='" & _H7  & "' fill='" & _c7  & "' rx='2'/>" &
"<rect x='" & _x8  & "' y='" & (_base-_H8)  & "' width='" & _bW & "' height='" & _H8  & "' fill='" & _c8  & "' rx='2'/>" &
"<rect x='" & _x9  & "' y='" & (_base-_H9)  & "' width='" & _bW & "' height='" & _H9  & "' fill='" & _c9  & "' rx='2'/>" &
"<rect x='" & _x10 & "' y='" & (_base-_H10) & "' width='" & _bW & "' height='" & _H10 & "' fill='" & _c10 & "' rx='2'/>" &
"<text x='" & (_x1 +_bW/2) & "' y='" & IF(_H1  < 20, _base-_H1 -5, _base-_H1 +14) & "' text-anchor='middle' fill='" & IF(_H1  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R1  & "</text>" &
"<text x='" & (_x2 +_bW/2) & "' y='" & IF(_H2  < 20, _base-_H2 -5, _base-_H2 +14) & "' text-anchor='middle' fill='" & IF(_H2  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R2  & "</text>" &
"<text x='" & (_x3 +_bW/2) & "' y='" & IF(_H3  < 20, _base-_H3 -5, _base-_H3 +14) & "' text-anchor='middle' fill='" & IF(_H3  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R3  & "</text>" &
"<text x='" & (_x4 +_bW/2) & "' y='" & IF(_H4  < 20, _base-_H4 -5, _base-_H4 +14) & "' text-anchor='middle' fill='" & IF(_H4  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R4  & "</text>" &
"<text x='" & (_x5 +_bW/2) & "' y='" & IF(_H5  < 20, _base-_H5 -5, _base-_H5 +14) & "' text-anchor='middle' fill='" & IF(_H5  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R5  & "</text>" &
"<text x='" & (_x6 +_bW/2) & "' y='" & IF(_H6  < 20, _base-_H6 -5, _base-_H6 +14) & "' text-anchor='middle' fill='" & IF(_H6  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R6  & "</text>" &
"<text x='" & (_x7 +_bW/2) & "' y='" & IF(_H7  < 20, _base-_H7 -5, _base-_H7 +14) & "' text-anchor='middle' fill='" & IF(_H7  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R7  & "</text>" &
"<text x='" & (_x8 +_bW/2) & "' y='" & IF(_H8  < 20, _base-_H8 -5, _base-_H8 +14) & "' text-anchor='middle' fill='" & IF(_H8  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R8  & "</text>" &
"<text x='" & (_x9 +_bW/2) & "' y='" & IF(_H9  < 20, _base-_H9 -5, _base-_H9 +14) & "' text-anchor='middle' fill='" & IF(_H9  < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R9  & "</text>" &
"<text x='" & (_x10+_bW/2) & "' y='" & IF(_H10 < 20, _base-_H10-5, _base-_H10+14) & "' text-anchor='middle' fill='" & IF(_H10 < 20, "#333", "#fff") & "' font-size='10' font-family='Segoe UI' font-weight='700'>" & _R10 & "</text>" &
"<line x1='20' y1='" & _base & "' x2='480' y2='" & _base & "' stroke='#dddddd' stroke-width='1'/>" &
"<text x='" & (_x1 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>0-10%</text>" &
"<text x='" & (_x2 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>10-20%</text>" &
"<text x='" & (_x3 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>20-30%</text>" &
"<text x='" & (_x4 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>30-40%</text>" &
"<text x='" & (_x5 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>40-50%</text>" &
"<text x='" & (_x6 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>50-60%</text>" &
"<text x='" & (_x7 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>60-70%</text>" &
"<text x='" & (_x8 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>70-80%</text>" &
"<text x='" & (_x9 +_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>80-90%</text>" &
"<text x='" & (_x10+_bW/2) & "' y='" & (_base+14) & "' text-anchor='middle' fill='#000' font-size='8' font-family='Segoe UI'>90-100%</text>" &
"</svg>" &
"<div style='text-align:right;color:#000000;font-size:18px;margin-top:2px'>Total asesores: " & _Total & "</div>" &
"</div>"

-- Cumplimiento_Num  ·  tabla Medidas
Cumplimiento_Num =
DIVIDE([Indice retencion], [Meta_Mes])

-- Meta_Mes  ·  tabla Medidas
Meta_Mes =
VAR _minFecha = CALCULATE(MIN('Calendar'[Date]))
VAR _minMes = DATE(YEAR(_minFecha), MONTH(_minFecha), 1)
VAR _maxMes = EOMONTH(_minFecha, 0)
RETURN
CALCULATE(
    MAX('vw_file_presupuesto_retenciones'[META_INDICE_RETENCION]),
    ALL('Calendar'),
    'vw_file_presupuesto_retenciones'[FECHA_EVALUACION] >= _minMes,
    'vw_file_presupuesto_retenciones'[FECHA_EVALUACION] <= _maxMes,
    'vw_file_presupuesto_retenciones'[TIPO] = "Agencia"
)

-- Pct_Motivo  ·  tabla Medidas
Pct_Motivo =
DIVIDE(
    CALCULATE(
        COUNTROWS('tickets_deserciones'),
        'tickets_deserciones'[Retencion] = "SI",
        'tickets_deserciones'[es_excluido] = FALSE()
    ),
    CALCULATE(
        COUNTROWS('tickets_deserciones'),
        ALL('tickets_deserciones'[Motivo_Real]),
        'tickets_deserciones'[Retencion] = "SI",
        'tickets_deserciones'[es_excluido] = FALSE()
    )
)

-- Total_solicitudes_Agencia  ·  tabla Medidas
Total_solicitudes_Agencia =
CALCULATE(
    COUNTROWS('tickets_deserciones'),
    'tickets_deserciones'[Departamento] = "Agencia",
    'tickets_deserciones'[es_excluido] = FALSE()
)

-- Total_solicitudes_CallCenter  ·  tabla Medidas
Total_solicitudes_CallCenter =
CALCULATE(
    COUNTROWS('tickets_deserciones'),
    'tickets_deserciones'[Departamento] = "CallCenter",
    'tickets_deserciones'[es_excluido] = FALSE()
)


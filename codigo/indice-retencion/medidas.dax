  <div style='font-size:16px;color:#111;margin-top:4px'>Ant " & FORMAT(_ant, "$#,##0.00") & " → Act " & FORMAT(_act, "$#,##0.00") & "</div>
</div>"

-- HTML_Card_Gana  ·  tabla Medidas
HTML_Card_Gana =
VAR _cnt = [HRet_Clientes_Ganan]
VAR _val = [HRet_Valor_Gana]
VAR _denOld = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _denNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _pct = DIVIDE(_cnt, _denOld + _denNew, 0)
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#f7fcf8;border-radius:8px;border:1px solid #d5f0dc;border-left:4px solid #1E8449;padding:14px 16px;box-sizing:border-box;height:100%'>
  <div style='font-size:15px;font-weight:600;color:#1E8449;margin-bottom:4px'>↑ GANA</div>
  <div style='font-size:36px;font-weight:600;color:#1E8449'>" & FORMAT(_cnt, "#,0") & "</div>

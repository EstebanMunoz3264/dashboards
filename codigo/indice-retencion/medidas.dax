-- HRet_Pct_Beneficio_vs_Motivo_1  ·  tabla Medidas
HRet_Pct_Beneficio_vs_Motivo_1 =
VAR _numOld = CALCULATE(COUNTROWS('retenciones_beneficios'), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _numNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _denOld = CALCULATE(COUNTROWS('retenciones_beneficios'), ALL('retenciones_beneficios'[beneficio_mod]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _denNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), ALL('retenciones_beneficios'[beneficio_mod]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
RETURN DIVIDE(_numOld + _numNew, _denOld + _denNew, 0)

-- HRet_Resumen_Clientes  ·  tabla Medidas
HRet_Resumen_Clientes =
VAR _fila = SELECTEDVALUE('_Metricas_Resumen'[OrdenFila], 0)
VAR _conOferta = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE())
VAR _OldClientes = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Ticket]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _NewClientes = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
RETURN
SWITCH(
    _fila,
    1, _OldClientes + _NewClientes,
    4, IF(_conOferta > 0, _conOferta, BLANK()),
    5, IF(_conOferta > 0, [HRet_Clientes_Ganan], BLANK()),
    6, IF(_conOferta > 0, [HRet_Clientes_Pierden], BLANK()),
    7, IF(_conOferta > 0, [HRet_Clientes_Mantienen], BLANK()),
    BLANK()
)

-- HRet_Resumen_Pesos  ·  tabla Medidas
HRet_Resumen_Pesos =
VAR _fila = SELECTEDVALUE('_Metricas_Resumen'[OrdenFila], 0)
VAR _conOfertaOld = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[INCREMENTO]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _conOfertaNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[INCREMENTO]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _conOferta = _conOfertaOld + _conOfertaNew
VAR _pctOferta = DIVIDE(_conOferta, [HRet_Total_Retenidos], 0)
VAR _pctGana = DIVIDE([HRet_Clientes_Ganan], _conOferta, 0)
VAR _pctPierde = DIVIDE([HRet_Clientes_Pierden], _conOferta, 0)
VAR _pctMantiene = DIVIDE([HRet_Clientes_Mantienen], _conOferta, 0)
VAR _totalConOfertaSinFiltro = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), REMOVEFILTERS('retenciones_beneficios'[Herramienta_Normalizada]), REMOVEFILTERS('retenciones_beneficios'[beneficios]), REMOVEFILTERS('retenciones_beneficios'[PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1))) + CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), REMOVEFILTERS('retenciones_beneficios'[Herramienta_Normalizada]), REMOVEFILTERS('retenciones_beneficios'[beneficios]), REMOVEFILTERS('retenciones_beneficios'[PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _totalRetenidosSinFiltro = CALCULATE(COUNTROWS('retenciones_beneficios'), REMOVEFILTERS('retenciones_beneficios'[Herramienta_Normalizada]), REMOVEFILTERS('retenciones_beneficios'[beneficios]), REMOVEFILTERS('retenciones_beneficios'[PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1))) + CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), REMOVEFILTERS('retenciones_beneficios'[Herramienta_Normalizada]), REMOVEFILTERS('retenciones_beneficios'[beneficios]), REMOVEFILTERS('retenciones_beneficios'[PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _currentTotal = [HRet_Total_Retenidos]
VAR _hayFiltroHerramienta = _totalRetenidosSinFiltro <> _currentTotal
VAR _pctVsConOferta = DIVIDE(_currentTotal, _totalConOfertaSinFiltro, 0)
RETURN
SWITCH(
    _fila,
    1, IF(_hayFiltroHerramienta, _pctVsConOferta, BLANK()),
    4, _pctOferta,
    5, _pctGana,
    6, _pctPierde,
    7, _pctMantiene,
    BLANK()
)

-- HRet_Resumen_Valores  ·  tabla Medidas
HRet_Resumen_Valores =
VAR _fila = SELECTEDVALUE('_Metricas_Resumen'[OrdenFila], 0)
RETURN
SWITCH(
    _fila,
    2,  [HRet_Valor_Total_Retenido],
    3,  [HRet_ARPU_Retenido],
    5,  [HRet_Valor_Gana],
    6,  [HRet_Valor_Pierde],
    8,  [HRet_Facturacion_Anterior],
    9,  [HRet_Facturacion_Actual],
    10, [HRet_Costo_Retencion],
    11, [HRet_ARPU_Anterior],
    12, [HRet_ARPU_Actual],
    13, [HRet_Diferencia_ARPU],
    BLANK()
)

-- HRet_Label_Herramienta  ·  tabla Medidas
HRet_Label_Herramienta =
VAR _cntOld = CALCULATE(COUNTROWS('retenciones_beneficios'), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _cntNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _cnt = _cntOld + _cntNew
VAR _totOld = CALCULATE(COUNTROWS('retenciones_beneficios'), ALL('retenciones_beneficios'[Herramienta_Normalizada]), ALL('retenciones_beneficios'[Validacion_Oferta_CRM_Tytan]), ALL('retenciones_beneficios'[beneficios]), ALL('retenciones_beneficios'[PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _totNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), ALL('retenciones_beneficios'[Herramienta_Normalizada]), ALL('retenciones_beneficios'[Validacion_Oferta_CRM_Tytan]), ALL('retenciones_beneficios'[beneficios]), ALL('retenciones_beneficios'[PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _pct = DIVIDE(_cnt, _totOld + _totNew, 0)
RETURN FORMAT(_cnt, "#,0") & "  |  " & FORMAT(_pct, "0.0%")

-- HTML_Card_ConOferta  ·  tabla Medidas
HTML_Card_ConOferta =
VAR _conOfertaOld = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _conOfertaNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _conOferta = _conOfertaOld + _conOfertaNew
VAR _totalOld = CALCULATE(COUNTROWS('retenciones_beneficios'), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _totalNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _pct = DIVIDE(_conOferta, _totalOld + _totalNew, 0)
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border-radius:8px;border:1px solid #E8DCEA;border-left:4px solid #783E80;padding:14px 16px;box-sizing:border-box;height:100%'>
  <div style='font-size:16px;color:#111;margin-bottom:4px'>Con oferta aplicada</div>
  <div style='font-size:38px;font-weight:600;color:#783E80'>" & FORMAT(_conOferta, "#,0") & "</div>
  <div style='font-size:16px;color:#111;margin-top:4px'>" & FORMAT(_pct, "0%") & " del total retenidos</div>
</div>"

-- HTML_Card_CostoRetencion  ·  tabla Medidas
HTML_Card_CostoRetencion =
VAR _costo = [HRet_Costo_Retencion]
VAR _color = IF(_costo < 0, "#C0392B", "#1E8449")
VAR _facAnt = [HRet_Facturacion_Anterior]
VAR _facAct = [HRet_Facturacion_Actual]
RETURN
"<div style='font-family:Segoe UI,sans-serif;background:#fff;border-radius:8px;border:1px solid #E8DCEA;border-left:4px solid " & _color & ";padding:14px 16px;box-sizing:border-box;height:100%'>
  <div style='font-size:16px;color:#111;margin-bottom:4px'>Costo de retención</div>
  <div style='font-size:36px;font-weight:600;color:" & _color & "'>" & FORMAT(_costo, "$#,##0.00") & "</div>
  <div style='font-size:16px;color:#111;margin-top:4px'>Ant: " & FORMAT(_facAnt, "$#,##0.00") & " → Act: " & FORMAT(_facAct, "$#,##0.00") & "</div>
</div>"

-- HTML_Card_DifARPU  ·  tabla Medidas
HTML_Card_DifARPU =
VAR _dif = [HRet_Diferencia_ARPU]

-- Indice retencion  ·  tabla Medidas
Indice retencion =
DIVIDE(
    CALCULATE(
        COUNTROWS('tickets_deserciones'),
        'tickets_deserciones'[Retencion] = "SI",
        'tickets_deserciones'[es_excluido] = FALSE()
    ),
    CALCULATE(
        COUNTROWS('tickets_deserciones'),
        'tickets_deserciones'[es_excluido] = FALSE()
    ),
    0
)

-- Indice Agencia  ·  tabla Medidas
Indice Agencia =
CALCULATE(
    DIVIDE(
        CALCULATE(COUNTROWS('tickets_deserciones'), 'tickets_deserciones'[Retencion] = "SI"),
        COUNTROWS('tickets_deserciones'),
        0
    ),
    'tickets_deserciones'[Departamento] = "Agencia",
    'tickets_deserciones'[es_excluido] = FALSE()
)

-- Indice CallCenter  ·  tabla Medidas
Indice CallCenter =
CALCULATE(
    DIVIDE(
        CALCULATE(COUNTROWS('tickets_deserciones'), 'tickets_deserciones'[Retencion] = "SI"),
        COUNTROWS('tickets_deserciones'),
        0
    ),
    'tickets_deserciones'[Departamento] = "CallCenter",
    'tickets_deserciones'[es_excluido] = FALSE()
)

-- Indice Total 1  ·  tabla Medidas
Indice Total 1 =
CALCULATE(
    DIVIDE(
        CALCULATE(COUNTROWS('tickets_deserciones'), 'tickets_deserciones'[Retencion] = "SI"),
        COUNTROWS('tickets_deserciones'),
        0
    ),
    'tickets_deserciones'[Departamento] IN {"Agencia", "CallCenter"},
    'tickets_deserciones'[es_excluido] = FALSE()
)


-- Pct_Motivo_no_retenido  ·  tabla Medidas
Pct_Motivo_no_retenido =
DIVIDE(
    CALCULATE(
        COUNTROWS('tickets_deserciones'),
        'tickets_deserciones'[Retencion] = "NO",
        'tickets_deserciones'[es_excluido] = FALSE()
    ),
    CALCULATE(
        COUNTROWS('tickets_deserciones'),
        ALL('tickets_deserciones'[Motivo_Real]),
        'tickets_deserciones'[Retencion] = "NO",
        'tickets_deserciones'[es_excluido] = FALSE()
    )
)


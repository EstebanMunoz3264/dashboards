</div>"

-- HRet_T1_Valor  ·  tabla Medidas
HRet_T1_Valor =
VAR _fila = SELECTEDVALUE('_Metricas_Tabla1'[OrdenFila], 0)
VAR _total = COUNTROWS('retenciones_beneficios')
RETURN
IF(
    _total = 0,
    BLANK(),
    SWITCH(
        _fila,
        2, [HRet_T1_Fact_Anterior],
        3, [HRet_T1_Fact_Actual],
        4, [HRet_T1_ARPU_Anterior],
        5, [HRet_T1_ARPU_Actual],
        6, [HRet_T1_Dif_ARPU],
        BLANK()
    )
)

-- HRet_T2_Cantidad  ·  tabla Medidas
HRet_T2_Cantidad =
VAR _HerramientasValidas = {"HERRAMIENTA 1","HERRAMIENTA 2","HERRAMIENTA 3","HERRAMIENTA 4","PLANES DE CAPTACION","PLANES DE MIGRACION"}
VAR _fila = SELECTEDVALUE('_Metricas_Tabla2'[OrdenFila], 0)
VAR _OldConOferta = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas))
VAR _NewConOferta = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas))
VAR _conOferta = _OldConOferta + _NewConOferta
RETURN
SWITCH(
    _fila,
    1, _conOferta,
    4, IF(_conOferta > 0, [HRet_Clientes_Ganan], BLANK()),
    5, IF(_conOferta > 0, [HRet_Clientes_Mantienen], BLANK()),
    6, IF(_conOferta > 0, [HRet_Clientes_Pierden], BLANK()),
    BLANK()
)

-- HRet_T2_Valor  ·  tabla Medidas
HRet_T2_Valor =
VAR _HerramientasValidas = {"HERRAMIENTA 1","HERRAMIENTA 2","HERRAMIENTA 3","HERRAMIENTA 4","PLANES DE CAPTACION","PLANES DE MIGRACION"}
VAR _fila = SELECTEDVALUE('_Metricas_Tabla2'[OrdenFila], 0)
VAR _conOfertaOld = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas))
VAR _conOfertaNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas))
VAR _conOferta = _conOfertaOld + _conOfertaNew
RETURN
SWITCH(
    _fila,
    2, [HRet_Facturacion_Anterior],
    3, [HRet_Facturacion_Actual],
    4, IF(_conOferta > 0, [HRet_Valor_Gana], BLANK()),
    6, IF(_conOferta > 0, [HRet_Valor_Pierde], BLANK()),
    7, [HRet_ARPU_Anterior],
    8, [HRet_ARPU_Actual],
    9, [HRet_Diferencia_ARPU],
    BLANK()
)

-- HRet_T1_Cantidad  ·  tabla Medidas
HRet_T1_Cantidad =
VAR _fila = SELECTEDVALUE('_Metricas_Tabla1'[OrdenFila], 0)
VAR _OldTotal = CALCULATE(COUNTROWS('retenciones_beneficios'), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _NewTotal = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _total = _OldTotal + _NewTotal
RETURN SWITCH(_fila, 1, IF(_total > 0, _total, BLANK()), BLANK())

-- HRet_T1_Fact_Anterior  ·  tabla Medidas
HRet_T1_Fact_Anterior =
VAR _Old = CALCULATE(
    VAR _con_plan = SUMX(FILTER('retenciones_beneficios', NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ANTIGUO])), 'retenciones_beneficios'[VALOR_PLAN_ANTIGUO])
    VAR _sin_plan = SUMX(FILTER('retenciones_beneficios', ISBLANK('retenciones_beneficios'[VALOR_PLAN_ANTIGUO])), 'retenciones_beneficios'[ARPU_INTERNET])
    RETURN _con_plan + IF(NOT ISBLANK(_sin_plan), _sin_plan, 0),
    'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1))
)
VAR _NewAccounts = CALCULATETABLE(VALUES('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _New = SUMX(
    _NewAccounts,
    VAR _tieneA = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ANTIGUO]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1))) > 0
    VAR _fA2 = CALCULATE(MAX('retenciones_beneficios'[Fecha_de_Ingreso]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ANTIGUO]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
    VAR _vA2 = CALCULATE(MAX('retenciones_beneficios'[VALOR_PLAN_ANTIGUO]), 'retenciones_beneficios'[Fecha_de_Ingreso] = _fA2)
    VAR _fArpu = CALCULATE(MAX('retenciones_beneficios'[Fecha_de_Ingreso]), NOT ISBLANK('retenciones_beneficios'[ARPU_INTERNET]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
    VAR _vArpu = CALCULATE(MAX('retenciones_beneficios'[ARPU_INTERNET]), 'retenciones_beneficios'[Fecha_de_Ingreso] = _fArpu)
    RETURN IF(_tieneA, _vA2, _vArpu)
)
RETURN _Old + _New

-- HRet_T1_Fact_Actual  ·  tabla Medidas
HRet_T1_Fact_Actual =
VAR _Old = CALCULATE(
    VAR _con_plan = SUMX(FILTER('retenciones_beneficios', NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL])), 'retenciones_beneficios'[VALOR_PLAN_ACTUAL])
    VAR _sin_plan = SUMX(FILTER('retenciones_beneficios', ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL])), 'retenciones_beneficios'[ARPU_INTERNET])
    RETURN _con_plan + IF(NOT ISBLANK(_sin_plan), _sin_plan, 0),
    'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1))
)
VAR _NewAccounts = CALCULATETABLE(VALUES('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
VAR _New = SUMX(
    _NewAccounts,
    VAR _tieneP = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1))) > 0
    VAR _fP = CALCULATE(MAX('retenciones_beneficios'[Fecha_de_Ingreso]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
    VAR _vP = CALCULATE(MAX('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[Fecha_de_Ingreso] = _fP)
    VAR _fA = CALCULATE(MAX('retenciones_beneficios'[Fecha_de_Ingreso]), NOT ISBLANK('retenciones_beneficios'[ARPU_INTERNET]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
    VAR _vA = CALCULATE(MAX('retenciones_beneficios'[ARPU_INTERNET]), 'retenciones_beneficios'[Fecha_de_Ingreso] = _fA)
    RETURN IF(_tieneP, _vP, _vA)
)
RETURN _Old + _New

-- HRet_T1_ARPU_Anterior  ·  tabla Medidas
HRet_T1_ARPU_Anterior =
VAR _OldDen = CALCULATE(COUNTROWS('retenciones_beneficios'), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _NewDen = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
RETURN DIVIDE([HRet_T1_Fact_Anterior], _OldDen + _NewDen, 0)

-- HRet_T1_ARPU_Actual  ·  tabla Medidas
HRet_T1_ARPU_Actual =
VAR _OldDen = CALCULATE(COUNTROWS('retenciones_beneficios'), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)))
VAR _NewDen = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
RETURN DIVIDE([HRet_T1_Fact_Actual], _OldDen + _NewDen, 0)

-- HRet_T1_Dif_ARPU  ·  tabla Medidas
HRet_T1_Dif_ARPU =
[HRet_T1_ARPU_Actual] - [HRet_T1_ARPU_Anterior]

-- HRet_T2_Pesos  ·  tabla Medidas
HRet_T2_Pesos =
VAR _HerramientasValidas = {"HERRAMIENTA 1","HERRAMIENTA 2","HERRAMIENTA 3","HERRAMIENTA 4","PLANES DE CAPTACION","PLANES DE MIGRACION"}
VAR _fila = SELECTEDVALUE('_Metricas_Tabla2'[OrdenFila], 0)
VAR _conOfertaOld = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[INCREMENTO]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas))
VAR _conOfertaNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[INCREMENTO]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas))
VAR _conOferta = _conOfertaOld + _conOfertaNew
VAR _pctGana = DIVIDE([HRet_Clientes_Ganan], _conOferta, 0)
VAR _pctPierde = DIVIDE([HRet_Clientes_Pierden], _conOferta, 0)
VAR _pctMantiene = DIVIDE([HRet_Clientes_Mantienen], _conOferta, 0)
VAR _totalConOferta = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas)) + CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas))
VAR _totalConOfertaGlobal = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), REMOVEFILTERS('retenciones_beneficios'[Herramienta_Normalizada]), REMOVEFILTERS('retenciones_beneficios'[beneficios]), REMOVEFILTERS('retenciones_beneficios'[PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1))) + CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), REMOVEFILTERS('retenciones_beneficios'[Herramienta_Normalizada]), REMOVEFILTERS('retenciones_beneficios'[beneficios]), REMOVEFILTERS('retenciones_beneficios'[PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
RETURN
SWITCH(
    _fila,
    1, DIVIDE(_totalConOferta, _totalConOfertaGlobal, 0),
    4, _pctGana,
    5, _pctMantiene,
    6, _pctPierde,
    BLANK()
)

-- HRet_T2_Pesos_Total  ·  tabla Medidas
HRet_T2_Pesos_Total =
VAR _HerramientasValidas = {"HERRAMIENTA 1","HERRAMIENTA 2","HERRAMIENTA 3","HERRAMIENTA 4","PLANES DE CAPTACION","PLANES DE MIGRACION"}
VAR _fila = SELECTEDVALUE('_Metricas_Tabla2'[OrdenFila], 0)
VAR _conOfertaOld = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[INCREMENTO]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas))
VAR _conOfertaNew = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[INCREMENTO]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas))
VAR _conOferta = _conOfertaOld + _conOfertaNew
VAR _pctGana = DIVIDE([HRet_Clientes_Ganan], _conOferta, 0)
VAR _pctPierde = DIVIDE([HRet_Clientes_Pierden], _conOferta, 0)
VAR _pctMantiene = DIVIDE([HRet_Clientes_Mantienen], _conOferta, 0)
VAR _totalConOferta = CALCULATE(COUNTROWS('retenciones_beneficios'), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas)) + CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas))
VAR _totalGeneral = CALCULATE(COUNTROWS('retenciones_beneficios'), REMOVEFILTERS('retenciones_beneficios'[Herramienta_Normalizada]), REMOVEFILTERS('retenciones_beneficios'[beneficios]), REMOVEFILTERS('retenciones_beneficios'[PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1))) + CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), REMOVEFILTERS('retenciones_beneficios'[Herramienta_Normalizada]), REMOVEFILTERS('retenciones_beneficios'[beneficios]), REMOVEFILTERS('retenciones_beneficios'[PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
RETURN
SWITCH(
    _fila,
    1, DIVIDE(_totalConOferta, _totalGeneral, 0),
    4, _pctGana,
    5, _pctMantiene,
    6, _pctPierde,
    BLANK()
)

-- Ef1_Total  ·  tabla Medidas
Ef1_Total =
IF(HASONEVALUE('_Ef_Tabla1'[Categoria]), CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), TREATAS(VALUES('_Ef_Tabla1'[Categoria]), 'retenciones_beneficios'[Herramienta_Combo_Adicional])), DISTINCTCOUNT('retenciones_beneficios'[Cuenta]))

-- Ef1_Pct  ·  tabla Medidas
Ef1_Pct =
DIVIDE([Ef1_Total], CALCULATE([Ef1_Total], ALL('_Ef_Tabla1')))

-- Ef2_H1  ·  tabla Medidas
Ef2_H1 =
CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[Herramienta_Combo_Adicional]="HERRAMIENTA 1", TREATAS(VALUES('_Ef_Tabla2'[Motivo_Real]), 'retenciones_beneficios'[Motivo_Real]))

-- Ef2_H2  ·  tabla Medidas
Ef2_H2 =
CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[Herramienta_Combo_Adicional]="HERRAMIENTA 2", TREATAS(VALUES('_Ef_Tabla2'[Motivo_Real]), 'retenciones_beneficios'[Motivo_Real]))

-- Ef2_H3  ·  tabla Medidas
Ef2_H3 =
CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[Herramienta_Combo_Adicional]="HERRAMIENTA 3", TREATAS(VALUES('_Ef_Tabla2'[Motivo_Real]), 'retenciones_beneficios'[Motivo_Real]))

-- Ef2_H4  ·  tabla Medidas
Ef2_H4 =
CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[Herramienta_Combo_Adicional]="HERRAMIENTA 4", TREATAS(VALUES('_Ef_Tabla2'[Motivo_Real]), 'retenciones_beneficios'[Motivo_Real]))

-- Ef2_Captacion  ·  tabla Medidas
Ef2_Captacion =
CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[Herramienta_Combo_Adicional]="PLANES DE CAPTACION", TREATAS(VALUES('_Ef_Tabla2'[Motivo_Real]), 'retenciones_beneficios'[Motivo_Real]))

-- Ef2_Migracion  ·  tabla Medidas
Ef2_Migracion =
CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[Herramienta_Combo_Adicional]="PLANES DE MIGRACION", TREATAS(VALUES('_Ef_Tabla2'[Motivo_Real]), 'retenciones_beneficios'[Motivo_Real]))

-- Ef2_Total_Ofertas  ·  tabla Medidas
Ef2_Total_Ofertas =
[Ef2_H1]+[Ef2_H2]+[Ef2_H3]+[Ef2_H4]+[Ef2_Captacion]+[Ef2_Migracion]

-- Ef2_Otras  ·  tabla Medidas
Ef2_Otras =
CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[Herramienta_Combo_Adicional]="RETENIDO CON OTRAS HERRAMIENTAS", TREATAS(VALUES('_Ef_Tabla2'[Motivo_Real]), 'retenciones_beneficios'[Motivo_Real]))

-- Ef2_Varias  ·  tabla Medidas
Ef2_Varias =
CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[Herramienta_Combo_Adicional]="RETENIDO CON VARIAS HERRAMIENTAS", TREATAS(VALUES('_Ef_Tabla2'[Motivo_Real]), 'retenciones_beneficios'[Motivo_Real]))

-- Ef2_Total_Retenidos  ·  tabla Medidas
Ef2_Total_Retenidos =
[Ef2_Total_Ofertas]+[Ef2_Otras]+[Ef2_Varias]

-- Ef2_Pct_Retenido  ·  tabla Medidas
Ef2_Pct_Retenido =
DIVIDE([Ef2_Total_Retenidos], CALCULATE([Ef2_Total_Retenidos], ALL('_Ef_Tabla2')))

-- Ef2_No_Retenidos  ·  tabla Medidas
Ef2_No_Retenidos =
CALCULATE(DISTINCTCOUNT('tickets_deserciones'[Cuenta]), 'tickets_deserciones'[Retencion]="NO", TREATAS(VALUES('_Ef_Tabla2'[Motivo_Real]), 'tickets_deserciones'[Motivo_Real]), TREATAS(VALUES('retenciones_beneficios'[Grupo]), 'tickets_deserciones'[Grupo]))

-- Ef2_Pct_No_Retenido  ·  tabla Medidas
Ef2_Pct_No_Retenido =
DIVIDE([Ef2_No_Retenidos], CALCULATE([Ef2_No_Retenidos], ALL('_Ef_Tabla2')))

-- Ef2_Total_Solicitudes  ·  tabla Medidas
Ef2_Total_Solicitudes =
[Ef2_Total_Retenidos]+[Ef2_No_Retenidos]

-- Ef2_Pct_Solicitudes  ·  tabla Medidas
Ef2_Pct_Solicitudes =
DIVIDE([Ef2_Total_Solicitudes], CALCULATE([Ef2_Total_Solicitudes], ALL('_Ef_Tabla2')))

-- Ef2_Pct_Retencion  ·  tabla Medidas
Ef2_Pct_Retencion =
DIVIDE([Ef2_Total_Retenidos], [Ef2_Total_Solicitudes])

-- Ef2_Pct_Ofertas  ·  tabla Medidas
Ef2_Pct_Ofertas =
DIVIDE([Ef2_Total_Ofertas], [Ef2_Total_Retenidos])

-- Ef2_Pct_Otras  ·  tabla Medidas
Ef2_Pct_Otras =
DIVIDE([Ef2_Otras], [Ef2_Total_Retenidos])

-- Ef2_Pct_Varias  ·  tabla Medidas
Ef2_Pct_Varias =
DIVIDE([Ef2_Varias], [Ef2_Total_Retenidos])

-- Ef3_Cuentas  ·  tabla Medidas
Ef3_Cuentas =
CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), TREATAS(VALUES('_Ef_Tabla2'[Motivo_Real]), 'retenciones_beneficios'[Motivo_Real]))

-- HRet_Facturacion_Actual  ·  tabla Medidas
HRet_Facturacion_Actual =
VAR _HerramientasValidas = {"HERRAMIENTA 1","HERRAMIENTA 2","HERRAMIENTA 3","HERRAMIENTA 4","PLANES DE CAPTACION","PLANES DE MIGRACION"}
VAR _Old = CALCULATE(
    SUMX(FILTER('retenciones_beneficios', NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL])), 'retenciones_beneficios'[VALOR_PLAN_ACTUAL]),
    'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] < DATE(2026,7,1)),
    KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas)
)
VAR _NewAccounts = CALCULATETABLE(
    VALUES('retenciones_beneficios'[Cuenta]),
    'retenciones_beneficios'[es_excluido] = FALSE(),
    KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)),
    KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas)
)
VAR _New = SUMX(
    _NewAccounts,
    VAR _f = CALCULATE(MAX('retenciones_beneficios'[Fecha_de_Ingreso]), NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas))
    RETURN IF(NOT ISBLANK(_f), CALCULATE(MAX('retenciones_beneficios'[VALOR_PLAN_ACTUAL]), 'retenciones_beneficios'[Fecha_de_Ingreso] = _f, KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas)))
)
RETURN _Old + _New

-- HRet_Facturacion_Anterior  ·  tabla Medidas
HRet_Facturacion_Anterior =
VAR _HerramientasValidas = {"HERRAMIENTA 1","HERRAMIENTA 2","HERRAMIENTA 3","HERRAMIENTA 4","PLANES DE CAPTACION","PLANES DE MIGRACION"}

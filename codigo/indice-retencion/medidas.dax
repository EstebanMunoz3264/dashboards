VAR _New = CALCULATE(DISTINCTCOUNT('retenciones_beneficios'[Cuenta]), 'retenciones_beneficios'[es_excluido] = FALSE(), KEEPFILTERS('retenciones_beneficios'[Fecha_de_Ingreso] >= DATE(2026,7,1)))
RETURN _Old + _New

-- HRet_Clientes_Ganan  ·  tabla Medidas
HRet_Clientes_Ganan =
VAR _HerramientasValidas = {"HERRAMIENTA 1","HERRAMIENTA 2","HERRAMIENTA 3","HERRAMIENTA 4","PLANES DE CAPTACION","PLANES DE MIGRACION"}
VAR _Clientes =
    ADDCOLUMNS(
        CALCULATETABLE(
            VALUES('retenciones_beneficios'[Cuenta]),
            'retenciones_beneficios'[es_excluido] = FALSE(),
            NOT ISBLANK('retenciones_beneficios'[VALOR_PLAN_ACTUAL]),
            KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas)
        ),
        "_inc",
        VAR _f = CALCULATE(MAX('retenciones_beneficios'[Fecha_de_Ingreso]), NOT ISBLANK('retenciones_beneficios'[INCREMENTO]), KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas))
        RETURN IF(NOT ISBLANK(_f), CALCULATE(MAX('retenciones_beneficios'[INCREMENTO]), 'retenciones_beneficios'[Fecha_de_Ingreso] = _f, KEEPFILTERS('retenciones_beneficios'[Herramienta_Agrupada] IN _HerramientasValidas)))
    )
RETURN
COUNTROWS(FILTER(_Clientes, NOT ISBLANK([_inc]) && [_inc] > 0.01))


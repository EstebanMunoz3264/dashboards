VAR wM    = FORMAT(pctM * 100, "0") & "%"
RETURN
IF(ISBLANK(total), "<div style='font-family:Segoe UI,sans-serif;padding:20px;color:#888'>Sin datos</div>",
"<div style='font-family:Segoe UI,sans-serif;padding:20px 22px;background:#fff;border:1px solid #e8e8e8;border-radius:12px;height:100%;box-sizing:border-box'>" &
  "<div style='display:flex;justify-content:space-between;align-items:baseline;margin-bottom:16px'>" &
    "<span style='font-size:15px;font-weight:600;color:#1a1a1a'>Call center</span>" &
    "<span style='font-size:12px;color:#000'>" & fmtT & " tickets</span>" &
  "</div>" &
  "<div style='margin-bottom:12px'>" &
    "<div style='display:flex;align-items:center;gap:10px;margin-bottom:8px'>" &
      "<span style='font-size:12px;color:#000;width:58px;text-align:right;flex-shrink:0'>Bien tip.</span>" &
      "<div style='flex:1;height:8px;background:#f0f0f0;border-radius:4px;overflow:hidden'>" &
        "<div style='height:100%;width:" & wB & ";background:#37173C;border-radius:4px'></div>" &
      "</div>" &
      "<span style='font-size:12px;font-weight:500;color:#37173C;width:40px;text-align:right'>" & fmtB & "</span>" &
    "</div>" &
    "<div style='display:flex;align-items:center;gap:10px'>" &
      "<span style='font-size:12px;color:#000;width:58px;text-align:right;flex-shrink:0'>Mal tip.</span>" &
      "<div style='flex:1;height:8px;background:#f0f0f0;border-radius:4px;overflow:hidden'>" &
        "<div style='height:100%;width:" & wM & ";background:#9F62B0;border-radius:4px'></div>" &
      "</div>" &
      "<span style='font-size:12px;font-weight:500;color:#9F62B0;width:40px;text-align:right'>" & fmtM & "</span>" &
    "</div>" &
  "</div>" &
"</div>")

-- % Error Agencia  ·  tabla _Medidas
% Error Agencia =
CALCULATE([% Error], result[Canal_1] = "Agencia")

-- % Error CallCenter  ·  tabla _Medidas
% Error CallCenter =
CALCULATE([% Error], result[Canal_1] = "CallCenter")

-- Total Tickets Agencia  ·  tabla _Medidas
Total Tickets Agencia =
CALCULATE([Total Tickets], result[Canal_1] = "Agencia")

-- Mal Tipificados Agencia  ·  tabla _Medidas
Mal Tipificados Agencia =
CALCULATE([Mal Tipificados], result[Canal_1] = "Agencia")

-- Total Tickets CallCenter  ·  tabla _Medidas
Total Tickets CallCenter =
CALCULATE([Total Tickets], result[Canal_1] = "CallCenter")

-- Mal Tipificados CallCenter  ·  tabla _Medidas
Mal Tipificados CallCenter =
CALCULATE([Mal Tipificados], result[Canal_1] = "CallCenter")

-- Valor Resumen Cruce  ·  tabla _Medidas
Valor Resumen Cruce =
SUM(Matriz_Resumen_Cruce[Valor])

-- Total Tickets Mes Anterior  ·  tabla _Medidas
Total Tickets Mes Anterior =
CALCULATE([Total Tickets], DATEADD(Calendar[Date], -1, MONTH))

-- Color % Error  ·  tabla _Medidas
Color % Error =
VAR e = [% Error]
RETURN
    SWITCH(TRUE(),
        ISBLANK(e), BLANK(),
        e < 0.15, "#B59AC0",
        e < 0.25, "#9F62B0",
        "#37173C"
    )

-- Color % Error Agencia  ·  tabla _Medidas
Color % Error Agencia =
VAR e = [% Error Agencia]
RETURN
    SWITCH(TRUE(),
        ISBLANK(e), BLANK(),
        e < 0.15, "#B59AC0",
        e < 0.25, "#9F62B0",
        "#37173C"
    )

-- Color % Error CallCenter  ·  tabla _Medidas
Color % Error CallCenter =
VAR e = [% Error CallCenter]
RETURN
    SWITCH(TRUE(),
        ISBLANK(e), BLANK(),
        e < 0.15, "#B59AC0",
        e < 0.25, "#9F62B0",
        "#37173C"
    )

-- Casos Fuga Interacciones  ·  tabla _Medidas
Casos Fuga Interacciones =
CALCULATE(COUNTROWS(detalle_interacciones_deserciones), KEEPFILTERS(detalle_interacciones_deserciones[en_flujos] = "SI"), KEEPFILTERS(detalle_interacciones_deserciones[en_retenciones] = "NO"))

-- Base Fuga Interacciones  ·  tabla _Medidas
Base Fuga Interacciones =
COUNTROWS(detalle_interacciones_deserciones)

-- HTML Fuga Interacciones  ·  tabla _Medidas
HTML Fuga Interacciones =
VAR _casos = [Casos Fuga Interacciones]
VAR _base = [Base Fuga Interacciones]
VAR _pct = DIVIDE(_casos, _base)
VAR _unMes = HASONEVALUE(Calendar[YearMonth])
VAR _ant = IF(_unMes, CALCULATE([Casos Fuga Interacciones], DATEADD(Calendar[Date], -1, MONTH)))
VAR _var = DIVIDE(_casos - _ant, _ant)
VAR _hayAnt = _unMes && NOT ISBLANK(_ant) && _ant > 0
VAR _txtVar =
    IF(_hayAnt,
        IF(_var >= 0, "▲ ", "▼ ") & FORMAT(ABS(_var), "0%") & " vs mes anterior (" & FORMAT(_ant, "#,##0") & ")",
        IF(_unMes, "Sin datos del mes anterior", "Selecciona un mes para comparar con el anterior"))
VAR _colVar = IF(_hayAnt && _var > 0, "#37173C", "#8A8090")
VAR _pesoVar = IF(_hayAnt && _var > 0, "600", "400")
VAR _agentes =
    FILTER(
        ADDCOLUMNS(VALUES(detalle_interacciones_deserciones[Agente]),
            "_n", [Casos Fuga Interacciones],
            "_ag", CALCULATE(MAX(detalle_interacciones_deserciones[Agencia (Usuarios)]))),
        [_n] > 0)
VAR _nAg = COUNTROWS(_agentes)
VAR _top = TOPN(10, _agentes, [_n], DESC, detalle_interacciones_deserciones[Agente], ASC)
VAR _max = MAXX(_top, [_n])
VAR _sumTop = SUMX(_top, [_n])
VAR _filas =
    CONCATENATEX(_top,
        "<div style='display:flex;align-items:center;gap:10px;margin:0 0 7px 0'>" &
          "<div style='width:200px;flex-shrink:0;overflow:hidden'>" &
            "<div style='font-size:12px;font-weight:500;color:#1a1a1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & detalle_interacciones_deserciones[Agente] & "</div>" &
            "<div style='font-size:10px;color:#8A8090;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & IF(ISBLANK([_ag]) || [_ag] = "", "&nbsp;", [_ag]) & "</div>" &
          "</div>" &
          "<div style='flex:1;height:10px;background:#F0EAF2;border-radius:5px;overflow:hidden'>" &
            "<div style='height:100%;width:" & FORMAT(DIVIDE([_n], _max) * 100, "0") & "%;background:#37173C;border-radius:5px'></div>" &
          "</div>" &
          "<div style='width:90px;flex-shrink:0;text-align:right;font-size:12px;color:#1a1a1a'><b>" & FORMAT([_n], "#,##0") & "</b> <span style='color:#8A8090'>· " & FORMAT(DIVIDE([_n], _casos), "0%") & "</span></div>" &
        "</div>",
        "", [_n], DESC, detalle_interacciones_deserciones[Agente], ASC)
VAR _pie =
    IF(_nAg > 10,
        "Top 10 de " & FORMAT(_nAg, "#,##0") & " agentes · concentran el " & FORMAT(DIVIDE(_sumTop, _casos), "0%") & " de los casos",
        FORMAT(_nAg, "#,##0") & " agentes con casos")
VAR _cab =
    "<div style='font-size:14px;font-weight:600;color:#37173C;margin-bottom:2px'>Interacciones sin ticket de retención y con flujo de cancelación</div>" &
    "<div style='font-size:11px;color:#8A8090;margin-bottom:12px'>Llamaron para desertar, no pasaron a retención y ya tienen flujo de baja en Tytan</div>"
RETURN
"<div style='font-family:Segoe UI,sans-serif;padding:16px 18px;background:#fff;border:1px solid #e8e8e8;border-top:4px solid #37173C;border-radius:12px;height:100%;box-sizing:border-box'>" &
  _cab &
  IF(ISBLANK(_casos) || _casos = 0,
    "<div style='font-size:13px;color:#8A8090;padding:24px 0'>Sin casos en el periodo seleccionado</div>",
    "<div style='display:flex;align-items:baseline;gap:12px;margin-bottom:4px'>" &
      "<span style='font-size:28px;font-weight:600;color:#1a1a1a;line-height:1'>" & FORMAT(_casos, "#,##0") & "</span>" &
      "<span style='font-size:12px;color:#37173C;background:#F0EAF2;padding:2px 8px;border-radius:20px'>" & FORMAT(_pct, "0.0%") & " de las interacciones de deserción</span>" &
    "</div>" &
    "<div style='font-size:11px;font-weight:" & _pesoVar & ";color:" & _colVar & ";margin-bottom:14px'>" & _txtVar & "</div>" &
    "<div style='border-top:1px solid #F0EAF2;padding-top:12px'>" & _filas & "</div>" &
    "<div style='font-size:10px;color:#8A8090;margin-top:6px'>" & _pie & "</div>") &
"</div>"

-- Casos Fuga Flujos  ·  tabla _Medidas
Casos Fuga Flujos =
CALCULATE(COUNTROWS(detalle_flujos_deserciones), KEEPFILTERS(detalle_flujos_deserciones[en_retencion] = "NO"))

-- Base Fuga Flujos  ·  tabla _Medidas
Base Fuga Flujos =
COUNTROWS(detalle_flujos_deserciones)

-- HTML Fuga Flujos  ·  tabla _Medidas
HTML Fuga Flujos =
VAR _casos = [Casos Fuga Flujos]
VAR _base = [Base Fuga Flujos]
VAR _pct = DIVIDE(_casos, _base)
VAR _unMes = HASONEVALUE(Calendar[YearMonth])
VAR _ant = IF(_unMes, CALCULATE([Casos Fuga Flujos], DATEADD(Calendar[Date], -1, MONTH)))
VAR _var = DIVIDE(_casos - _ant, _ant)
VAR _hayAnt = _unMes && NOT ISBLANK(_ant) && _ant > 0
VAR _txtVar =
    IF(_hayAnt,
        IF(_var >= 0, "▲ ", "▼ ") & FORMAT(ABS(_var), "0%") & " vs mes anterior (" & FORMAT(_ant, "#,##0") & ")",
        IF(_unMes, "Sin datos del mes anterior", "Selecciona un mes para comparar con el anterior"))
VAR _colVar = IF(_hayAnt && _var > 0, "#37173C", "#8A8090")
VAR _pesoVar = IF(_hayAnt && _var > 0, "600", "400")
VAR _agentes =
    FILTER(
        ADDCOLUMNS(VALUES(detalle_flujos_deserciones[Agente]),
            "_n", [Casos Fuga Flujos],
            "_ag", CALCULATE(MAX(detalle_flujos_deserciones[Agencia (Usuarios)]))),
        [_n] > 0)
VAR _nAg = COUNTROWS(_agentes)
VAR _top = TOPN(10, _agentes, [_n], DESC, detalle_flujos_deserciones[Agente], ASC)
VAR _max = MAXX(_top, [_n])
VAR _sumTop = SUMX(_top, [_n])
VAR _filas =
    CONCATENATEX(_top,
        "<div style='display:flex;align-items:center;gap:10px;margin:0 0 7px 0'>" &
          "<div style='width:200px;flex-shrink:0;overflow:hidden'>" &
            "<div style='font-size:12px;font-weight:500;color:#1a1a1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & detalle_flujos_deserciones[Agente] & "</div>" &
            "<div style='font-size:10px;color:#8A8090;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & IF(ISBLANK([_ag]) || [_ag] = "", "&nbsp;", [_ag]) & "</div>" &
          "</div>" &
          "<div style='flex:1;height:10px;background:#F0EAF2;border-radius:5px;overflow:hidden'>" &
            "<div style='height:100%;width:" & FORMAT(DIVIDE([_n], _max) * 100, "0") & "%;background:#37173C;border-radius:5px'></div>" &
          "</div>" &
          "<div style='width:90px;flex-shrink:0;text-align:right;font-size:12px;color:#1a1a1a'><b>" & FORMAT([_n], "#,##0") & "</b> <span style='color:#8A8090'>· " & FORMAT(DIVIDE([_n], _casos), "0%") & "</span></div>" &
        "</div>",
        "", [_n], DESC, detalle_flujos_deserciones[Agente], ASC)
VAR _pie =
    IF(_nAg > 10,
        "Top 10 de " & FORMAT(_nAg, "#,##0") & " agentes · concentran el " & FORMAT(DIVIDE(_sumTop, _casos), "0%") & " de los casos",
        FORMAT(_nAg, "#,##0") & " agentes con casos")
VAR _cab =
    "<div style='font-size:14px;font-weight:600;color:#37173C;margin-bottom:2px'>Flujos de cancelación sin ticket de retención</div>" &
    "<div style='font-size:11px;color:#8A8090;margin-bottom:12px'>Bajas procesadas en Tytan sin ningún ticket de retención registrado</div>"
RETURN
"<div style='font-family:Segoe UI,sans-serif;padding:16px 18px;background:#fff;border:1px solid #e8e8e8;border-top:4px solid #37173C;border-radius:12px;height:100%;box-sizing:border-box'>" &
  _cab &
  IF(ISBLANK(_casos) || _casos = 0,
    "<div style='font-size:13px;color:#8A8090;padding:24px 0'>Sin casos en el periodo seleccionado</div>",
    "<div style='display:flex;align-items:baseline;gap:12px;margin-bottom:4px'>" &
      "<span style='font-size:28px;font-weight:600;color:#1a1a1a;line-height:1'>" & FORMAT(_casos, "#,##0") & "</span>" &
      "<span style='font-size:12px;color:#37173C;background:#F0EAF2;padding:2px 8px;border-radius:20px'>" & FORMAT(_pct, "0.0%") & " de los flujos de cancelación</span>" &
    "</div>" &
    "<div style='font-size:11px;font-weight:" & _pesoVar & ";color:" & _colVar & ";margin-bottom:14px'>" & _txtVar & "</div>" &
    "<div style='border-top:1px solid #F0EAF2;padding-top:12px'>" & _filas & "</div>" &
    "<div style='font-size:10px;color:#8A8090;margin-top:6px'>" & _pie & "</div>") &
"</div>"

-- Casos Retenidos con Flujo  ·  tabla _Medidas
Casos Retenidos con Flujo =
CALCULATE(COUNTROWS(detalle_retenciones_deserciones), KEEPFILTERS(detalle_retenciones_deserciones[escenario_auditoria] = "RETENIDO CON FLUJO - INCONSISTENTE"))

-- Base Retenidos con Flujo  ·  tabla _Medidas
Base Retenidos con Flujo =
CALCULATE(COUNTROWS(detalle_retenciones_deserciones), KEEPFILTERS(detalle_retenciones_deserciones[Retencion] IN {"SI", "SI CRM"}))

-- HTML Retenidos con Flujo  ·  tabla _Medidas
HTML Retenidos con Flujo =
VAR _casos = [Casos Retenidos con Flujo]
VAR _base = [Base Retenidos con Flujo]
VAR _pct = DIVIDE(_casos, _base)
VAR _unMes = HASONEVALUE(Calendar[YearMonth])
VAR _ant = IF(_unMes, CALCULATE([Casos Retenidos con Flujo], DATEADD(Calendar[Date], -1, MONTH)))
VAR _var = DIVIDE(_casos - _ant, _ant)
VAR _hayAnt = _unMes && NOT ISBLANK(_ant) && _ant > 0
VAR _txtVar =
    IF(_hayAnt,
        IF(_var >= 0, "▲ ", "▼ ") & FORMAT(ABS(_var), "0%") & " vs mes anterior (" & FORMAT(_ant, "#,##0") & ")",
        IF(_unMes, "Sin datos del mes anterior", "Selecciona un mes para comparar con el anterior"))
VAR _colVar = IF(_hayAnt && _var > 0, "#37173C", "#8A8090")
VAR _pesoVar = IF(_hayAnt && _var > 0, "600", "400")
VAR _agentes =
    FILTER(
        ADDCOLUMNS(VALUES(detalle_retenciones_deserciones[Agente]),
            "_n", [Casos Retenidos con Flujo],
            "_ag", CALCULATE(MAX(detalle_retenciones_deserciones[Agencia (Usuarios)]))),
        [_n] > 0)
VAR _nAg = COUNTROWS(_agentes)
VAR _top = TOPN(10, _agentes, [_n], DESC, detalle_retenciones_deserciones[Agente], ASC)
VAR _max = MAXX(_top, [_n])
VAR _sumTop = SUMX(_top, [_n])
VAR _filas =
    CONCATENATEX(_top,
        "<div style='display:flex;align-items:center;gap:10px;margin:0 0 7px 0'>" &
          "<div style='width:200px;flex-shrink:0;overflow:hidden'>" &
            "<div style='font-size:12px;font-weight:500;color:#1a1a1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & detalle_retenciones_deserciones[Agente] & "</div>" &
            "<div style='font-size:10px;color:#8A8090;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & IF(ISBLANK([_ag]) || [_ag] = "", "&nbsp;", [_ag]) & "</div>" &
          "</div>" &
          "<div style='flex:1;height:10px;background:#F0EAF2;border-radius:5px;overflow:hidden'>" &
            "<div style='height:100%;width:" & FORMAT(DIVIDE([_n], _max) * 100, "0") & "%;background:#9F62B0;border-radius:5px'></div>" &
          "</div>" &
          "<div style='width:90px;flex-shrink:0;text-align:right;font-size:12px;color:#1a1a1a'><b>" & FORMAT([_n], "#,##0") & "</b> <span style='color:#8A8090'>· " & FORMAT(DIVIDE([_n], _casos), "0%") & "</span></div>" &
        "</div>",
        "", [_n], DESC, detalle_retenciones_deserciones[Agente], ASC)
VAR _pie =
    IF(_nAg > 10,
        "Top 10 de " & FORMAT(_nAg, "#,##0") & " agentes · concentran el " & FORMAT(DIVIDE(_sumTop, _casos), "0%") & " de los casos",
        FORMAT(_nAg, "#,##0") & " agentes con casos")
VAR _cab =
    "<div style='font-size:14px;font-weight:600;color:#37173C;margin-bottom:2px'>Tickets retenidos con flujo de cancelación</div>" &
    "<div style='font-size:11px;color:#8A8090;margin-bottom:12px'>Marcados como retenidos en CRM, pero el cliente tiene flujo de baja</div>"
RETURN
"<div style='font-family:Segoe UI,sans-serif;padding:16px 18px;background:#fff;border:1px solid #e8e8e8;border-top:4px solid #9F62B0;border-radius:12px;height:100%;box-sizing:border-box'>" &
  _cab &
  IF(ISBLANK(_casos) || _casos = 0,
    "<div style='font-size:13px;color:#8A8090;padding:24px 0'>Sin casos en el periodo seleccionado</div>",
    "<div style='display:flex;align-items:baseline;gap:12px;margin-bottom:4px'>" &
      "<span style='font-size:28px;font-weight:600;color:#1a1a1a;line-height:1'>" & FORMAT(_casos, "#,##0") & "</span>" &
      "<span style='font-size:12px;color:#37173C;background:#F0EAF2;padding:2px 8px;border-radius:20px'>" & FORMAT(_pct, "0.0%") & " de los tickets retenidos</span>" &
    "</div>" &
    "<div style='font-size:11px;font-weight:" & _pesoVar & ";color:" & _colVar & ";margin-bottom:14px'>" & _txtVar & "</div>" &
    "<div style='border-top:1px solid #F0EAF2;padding-top:12px'>" & _filas & "</div>" &
    "<div style='font-size:10px;color:#8A8090;margin-top:6px'>" & _pie & "</div>") &
"</div>"

-- Casos No Retenidos sin Flujo  ·  tabla _Medidas
Casos No Retenidos sin Flujo =
CALCULATE(COUNTROWS(detalle_retenciones_deserciones), KEEPFILTERS(detalle_retenciones_deserciones[escenario_auditoria] = "NO RETENIDO SIN FLUJO - CANCELACION NO REGISTRADA"))

-- Base No Retenidos sin Flujo  ·  tabla _Medidas
Base No Retenidos sin Flujo =
CALCULATE(COUNTROWS(detalle_retenciones_deserciones), KEEPFILTERS(detalle_retenciones_deserciones[Retencion] = "NO"))

-- HTML No Retenidos sin Flujo  ·  tabla _Medidas
HTML No Retenidos sin Flujo =
VAR _casos = [Casos No Retenidos sin Flujo]
VAR _base = [Base No Retenidos sin Flujo]
VAR _pct = DIVIDE(_casos, _base)
VAR _unMes = HASONEVALUE(Calendar[YearMonth])
VAR _ant = IF(_unMes, CALCULATE([Casos No Retenidos sin Flujo], DATEADD(Calendar[Date], -1, MONTH)))
VAR _var = DIVIDE(_casos - _ant, _ant)
VAR _hayAnt = _unMes && NOT ISBLANK(_ant) && _ant > 0
VAR _txtVar =
    IF(_hayAnt,
        IF(_var >= 0, "▲ ", "▼ ") & FORMAT(ABS(_var), "0%") & " vs mes anterior (" & FORMAT(_ant, "#,##0") & ")",
        IF(_unMes, "Sin datos del mes anterior", "Selecciona un mes para comparar con el anterior"))
VAR _colVar = IF(_hayAnt && _var > 0, "#37173C", "#8A8090")
VAR _pesoVar = IF(_hayAnt && _var > 0, "600", "400")
VAR _agentes =
    FILTER(
        ADDCOLUMNS(VALUES(detalle_retenciones_deserciones[Agente]),
            "_n", [Casos No Retenidos sin Flujo],
            "_ag", CALCULATE(MAX(detalle_retenciones_deserciones[Agencia (Usuarios)]))),
        [_n] > 0)
VAR _nAg = COUNTROWS(_agentes)
VAR _top = TOPN(10, _agentes, [_n], DESC, detalle_retenciones_deserciones[Agente], ASC)
VAR _max = MAXX(_top, [_n])
VAR _sumTop = SUMX(_top, [_n])
VAR _filas =
    CONCATENATEX(_top,
        "<div style='display:flex;align-items:center;gap:10px;margin:0 0 7px 0'>" &
          "<div style='width:200px;flex-shrink:0;overflow:hidden'>" &
            "<div style='font-size:12px;font-weight:500;color:#1a1a1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & detalle_retenciones_deserciones[Agente] & "</div>" &
            "<div style='font-size:10px;color:#8A8090;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & IF(ISBLANK([_ag]) || [_ag] = "", "&nbsp;", [_ag]) & "</div>" &
          "</div>" &
          "<div style='flex:1;height:10px;background:#F0EAF2;border-radius:5px;overflow:hidden'>" &
            "<div style='height:100%;width:" & FORMAT(DIVIDE([_n], _max) * 100, "0") & "%;background:#9F62B0;border-radius:5px'></div>" &
          "</div>" &
          "<div style='width:90px;flex-shrink:0;text-align:right;font-size:12px;color:#1a1a1a'><b>" & FORMAT([_n], "#,##0") & "</b> <span style='color:#8A8090'>· " & FORMAT(DIVIDE([_n], _casos), "0%") & "</span></div>" &
        "</div>",
        "", [_n], DESC, detalle_retenciones_deserciones[Agente], ASC)
VAR _pie =
    IF(_nAg > 10,
        "Top 10 de " & FORMAT(_nAg, "#,##0") & " agentes · concentran el " & FORMAT(DIVIDE(_sumTop, _casos), "0%") & " de los casos",
        FORMAT(_nAg, "#,##0") & " agentes con casos")
VAR _cab =
    "<div style='font-size:14px;font-weight:600;color:#37173C;margin-bottom:2px'>Tickets no retenidos sin flujo de cancelación</div>" &
    "<div style='font-size:11px;color:#8A8090;margin-bottom:12px'>Marcados como no retenidos en CRM, pero no hay flujo de baja en Tytan</div>"
RETURN
"<div style='font-family:Segoe UI,sans-serif;padding:16px 18px;background:#fff;border:1px solid #e8e8e8;border-top:4px solid #9F62B0;border-radius:12px;height:100%;box-sizing:border-box'>" &
  _cab &
  IF(ISBLANK(_casos) || _casos = 0,
    "<div style='font-size:13px;color:#8A8090;padding:24px 0'>Sin casos en el periodo seleccionado</div>",
    "<div style='display:flex;align-items:baseline;gap:12px;margin-bottom:4px'>" &
      "<span style='font-size:28px;font-weight:600;color:#1a1a1a;line-height:1'>" & FORMAT(_casos, "#,##0") & "</span>" &
      "<span style='font-size:12px;color:#37173C;background:#F0EAF2;padding:2px 8px;border-radius:20px'>" & FORMAT(_pct, "0.0%") & " de los tickets no retenidos</span>" &
    "</div>" &
    "<div style='font-size:11px;font-weight:" & _pesoVar & ";color:" & _colVar & ";margin-bottom:14px'>" & _txtVar & "</div>" &
    "<div style='border-top:1px solid #F0EAF2;padding-top:12px'>" & _filas & "</div>" &
    "<div style='font-size:10px;color:#8A8090;margin-top:6px'>" & _pie & "</div>") &
"</div>"
